# This file contains default .gitignore rules. To use it, copy it to .gitignore,
# and it will cause files like your settings.php and user-uploaded files to be
# excluded from Git version control. This is a common strategy to avoid
# accidentally including private information in public repositories and patch
# files.
#
# Because .gitignore can be specific to your site, this file has a different
# name; updating Drupal core will not override your custom .gitignore file.

# Ignore core when managing all of a project's dependencies with Composer
# including Drupal core.
# core

# Ignore dependencies that are managed with Composer.
# Generally you should only ignore the root vendor directory. It's important
# that core/assets/vendor and any other vendor directories within contrib or
# custom module, theme, etc., are not ignored unless you purposely do so.
/vendor/

# Ignore configuration files that may contain sensitive information.
sites/*/settings*.php
sites/*/services*.yml

# Ignore paths that contain user-generated content.
sites/*/files
sites/*/private

# Ignore multi-site test environment.
sites/simpletest

# If you prefer to store your .gitignore file in the sites/ folder, comment
# or delete the previous settings and uncomment the following ones, instead.

# Ignore configuration files that may contain sensitive information.
# */settings*.php

# Ignore paths that contain user-generated content.
# */files
# */private

# Ignore multi-site test environment.
# simpletest
/autoload.php
/autoload_runtime.php

# Generated Graphify knowledge-graph artifacts.
graphify-out/
graph.json

# Local DBHub credentials for the read-only database account.
/.claude/dbhub.toml

# Local, machine-specific AI handoff cache.
/SESSION_STATE.md

# Generated browser-QA output only. The permanent QA tools under qa/browser/ and
# qa/support/ are source and stay tracked — never widen these two patterns to the
# whole qa/ tree.
/qa/artifacts/
/qa/tmp/

# Claude Code writes these while merging local settings; they are not source.
/.claude/settings.local.json.tmp.*
/.claude/tmp/

# Database exports and archive copies taken at the repository root. These carry
# real accounts, customer submissions, sessions and log rows; they must never be
# re-added. Anchored to the root on purpose — do not widen to *.sql or *.zip,
# which would swallow legitimate fixtures inside core and contrib.
/ppu.sql
/ppu*.sql
/ppu*.sql.zip
/ppu*.tar.gz

# settings.php backups. The live sites/*/settings*.php files are already covered
# above, but a ".backup-" suffix does not end in .php, so it slipped past.
/sites/default/settings.php.backup-*
/web/sites/default/settings.php
/web/sites/default/settings.php.backup-*

# Two duplicate trees that project rules exclude from this repository: the
# parallel web/ docroot and the root-level copy of the custom module. The active
# module lives at modules/custom_webform_handlers/ and stays tracked — the
# leading slash below anchors this rule to the repository root so it cannot
# match that path.
/web/
/custom_webform_handlers/

# Composer installs Drupal core and every contributed project into these two
# trees (drupal/core -> /core, drupal/<project> -> /modules/contrib/<project>).
# composer.json and composer.lock are the versioned declaration; the installed
# source is generated and is reconstructed by `composer install`. Anchored and
# narrow on purpose: /modules/contrib/ must not be widened to /modules/, which
# would swallow the active custom module at modules/custom_webform_handlers/.
/core/
/modules/contrib/

# Disposable screenshots Claude wrote beside the settings files. The permanent
# browser-QA output already lives under the ignored qa/artifacts/; this pattern
# only covers the stray .claude/tmp-*.png copies and is not a blanket *.png.
/.claude/tmp-*.png

# One-off scratch files left at the repository root by earlier sessions: a
# mistyped redirect target, two saved diffs, a lifted Webform page fragment,
# two architecture note dumps, a bootstrap script, and a module zip snapshot.
# Each is named exactly — no *.diff, *.zip or *.txt wildcard.
/utputFormat
/changes.diff
/final_changes.diff
/page_1_updated.yml
/ARCHITECT.txt
/ARCHITECT.txt.txt
/ppu-boot.ps1
/modules/w9.custom_webform_handlers_step16_production_hardening.zip

# drupal/core-composer-scaffold output. Every path below was proven byte-identical
# to its source under core/assets/scaffold/files/ (the mapping lives in
# core/composer.json extra.drupal-scaffold.file-mapping; this project resolves
# [web-root] and [project-root] to the repository root). `composer install`
# regenerates them, so they are build output rather than authored source.
#
# Each entry is an exact anchored path on purpose. There is deliberately no
# root-file, sites/**, profiles/** or themes/** wildcard here: authored siblings
# such as /LICENSE.txt, /.user.ini, /CLAUDE.md, /CONTEXT.md,
# /composer.json, /composer.lock and /sites/sites.php must stay trackable, and
# /README.md below is the Drupal scaffold README — it cannot reach qa/README.md
# or docs/**, which are anchored away by the leading slash.
#
# The 23rd mapping entry, modules/README.txt, is already excluded by the nested
# modules/.gitignore and is intentionally not repeated here.
/.csslintrc
/.editorconfig
/.eslintignore
/.eslintrc.json
/.gitattributes
/.ht.router.php
/.htaccess
/example.gitignore
/index.php
/robots.txt
/update.php
/web.config
/INSTALL.txt
/README.md
/profiles/README.txt
/themes/README.txt
/sites/README.txt
/sites/default/default.services.yml
/sites/default/default.settings.php
/sites/development.services.yml
/sites/example.settings.local.php
/sites/example.sites.php

# ddev/ddev-selenium-standalone-chrome add-on output. Its first line is the
# #ddev-generated marker, so `ddev get ddev/ddev-selenium-standalone-chrome`
# rewrites it, and two of its web_environment entries embed a
# scheme://user:pass@host test-database URL. Generated plus credential-bearing,
# therefore never versioned — it is recreated by re-adding the add-on.
#
# Exactly this one path, anchored to the root. The rest of .ddev/ is authored or
# credential-free and stays tracked (.ddev/config.yaml, the two
# addon-metadata/*/manifest.yaml files, the redis and command scripts), so this
# must never be widened to /.ddev/ or /.ddev/config.*.yaml.
/.ddev/config.selenium-standalone-chrome.yaml

# Local agent/tool configuration. Machine-bound (absolute host paths, per-user
# tokens) and unnecessary to build, test or run the committed Dispatch system, so
# it is kept on disk and out of Git. Removed from the index by TASK 14B; nothing
# in composer.json, .ddev/, the module, or qa/ reads any of these paths.
#
# These rules match the named directories/contents only, so the repository-scoped,
# portable, credential-free .claudeignore, .graphifyignore and .gitnexusignore keep
# their existing tracked status, as do CLAUDE.md and CONTEXT.md — the latter is
# cited by 20 committed files and must stay versioned. Do not widen these to
# /.claude*, /.agents*, /modules/**, or /*.json — a bare /.claude* would also
# swallow the sibling .claudeignore, which must stay tracked.
/.agents/
/skills-lock.json
#
# .claude/ stays ignored by default, EXCEPT for an owner-authorized narrow
# exception (Task 24B prerequisite): exactly six DBHub connection-pool-repair
# source files are made eligible for ordinary version control. Git cannot
# re-include a path whose parent directory is excluded, so the former blanket
# /.claude/ is expanded into a level-by-level cascade — re-include each parent
# directory, re-ignore its contents, then allowlist the exact files. Everything
# else under .claude/ (credentials such as dbhub.toml, local configuration,
# memory, logs, temp, and the generated node_modules/ tree) stays ignored. Do NOT
# add further re-includes without explicit owner authorization.
/.claude/*
!/.claude/scripts/
/.claude/scripts/*
!/.claude/scripts/dbhub-mcp.cjs
!/.claude/tools/
/.claude/tools/*
!/.claude/tools/dbhub/
/.claude/tools/dbhub/*
!/.claude/tools/dbhub/package.json
!/.claude/tools/dbhub/package-lock.json
!/.claude/tools/dbhub/patch-target.cjs
!/.claude/tools/dbhub/provision.cjs
!/.claude/tools/dbhub/README.md
/modules/custom_webform_handlers/.claude/
/.mcp.json

# Unserved third-party error pages left at the repository root. TASK 15 proved
# both are unreferenced by anything that serves this site: 0 ErrorDocument and
# 0 error_page directives exist in .htaccess, web.config, .ht.router.php or
# .ddev/**; all 8 try_files directives route to /index.php or @rewrite; neither
# name appears in composer.json, composer.lock or the core scaffold
# file-mapping; and system.site page.403/page.404 are empty on both sites. Each
# file is a 74-line unbranded page holding one inline base64 image and a single
# outbound link to one third-party host, with 0 Drupal, DDEV or
# custom_webform_handlers markers -- generated third-party output rather than an
# intentional project page. Removed from the index by TASK 15; both remain on
# disk untouched. They were previously listed among the authored scaffold
# siblings further up, and that stale mention was corrected in the same change.
#
# Exactly these two anchored paths. Never widen this to /*.html, which would
# swallow any future authored root-level page.
/404.html
/502.html

# Local container runtime override; never portable project configuration.
/.user.ini

# Archived local execution briefs. Preserve on disk, never version as source.
/DISPATCH_PLANNER_EXECUTION_TASKS.md
/INSTALLATION_STEP15.md
/TASK_3_DISPATCH_PLANNER.md
/TASK_4_CLAUDE_CODE_PROMPT.md
/TASK_7_MICRO_PASSES.md
/TASK_7_RECOVERY_PROMPT.md

# Generated database password for the private Nominatim geocoder container
# (Task 20D prerequisite). The service definition in
# .ddev/docker-compose.nominatim.yaml is versioned deliberately -- only the
# secret is not, and it is regenerated per machine rather than shared.
#
# The rule lives here rather than in .ddev/.gitignore because DDEV rewrites
# that file on every start and would drop it.
/.ddev/.env.nominatim

# Generated DDEV web-container environment file. It carries the local database
# connection (user:password@host) that `ddev debug compose-config` resolves, so
# it is a per-machine secret, not portable project configuration. It currently
# exists on disk and is ignored only by the local, un-published
# .git/info/exclude (/.ddev/.env.* there) -- the versioned rule for its sibling
# .ddev/.env.nominatim did not cover it. Anchored to the exact path for the same
# reason as above: DDEV rewrites .ddev/.gitignore on every start, so the rule
# must live here. Do not widen to /.ddev/ or /.ddev/.env*, which could reach
# authored .ddev/ configuration.
/.ddev/.env.web
