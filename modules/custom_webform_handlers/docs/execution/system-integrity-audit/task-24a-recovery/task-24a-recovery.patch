@@ -0,0 +1,24 @@
+<?php
+
+namespace Drupal\custom_webform_handlers\Distance;
+
+/**
+ * Development-fixed route provider returning zero-cost deterministic facts.
+ */
+final class FixedDevelopmentRouteProvider implements DistanceProviderInterface, ScheduledRouteProviderInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function calculateDistance(string $origin, string $destination): DistanceResult {
+    return new DistanceResult(0, 0, 'development_fixed');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function calculateScheduledRoute(string $origin, string $destination, \DateTimeInterface $departureTime): DistanceResult {
+    return new DistanceResult(0, 0, 'development_fixed');
+  }
+
+}

diff --git a/modules/custom_webform_handlers/src/Distance/RoutingModeEntryProvider.php b/modules/custom_webform_handlers/src/Distance/RoutingModeEntryProvider.php
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/modules/custom_webform_handlers/src/Distance/RoutingModeEntryProvider.php
@@ -0,0 +1,38 @@
+<?php
+
+namespace Drupal\custom_webform_handlers\Distance;
+
+/**
+ * Entry-point provider routing requests based on current active routing mode.
+ */
+final class RoutingModeEntryProvider implements DistanceProviderInterface, ScheduledRouteProviderInterface {

+  public function __construct(
+    private readonly RoutingModeResolver $modeResolver,
+    private readonly FixedDevelopmentRouteProvider $fixedProvider,
+    private readonly DistanceProviderInterface $liveProvider,
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function calculateDistance(string $origin, string $destination): DistanceResult {
+    if ($this->modeResolver->isDevelopmentFixed()) {
+      return $this->fixedProvider->calculateDistance($origin, $destination);
+    }
+    return $this->liveProvider->calculateDistance($origin, $destination);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function calculateScheduledRoute(string $origin, string $destination, \DateTimeInterface $departureTime): DistanceResult {
+    if ($this->modeResolver->isDevelopmentFixed()) {
+      return $this->fixedProvider->calculateScheduledRoute($origin, $destination, $departureTime);
+    }
+    if ($this->liveProvider instanceof ScheduledRouteProviderInterface) {
+      return $this->liveProvider->calculateScheduledRoute($origin, $destination, $departureTime);
+    }
+    return $this->liveProvider->calculateDistance($origin, $destination);
+  }
+
+}

diff --git a/modules/custom_webform_handlers/src/Distance/RoutingModeResolver.php b/modules/custom_webform_handlers/src/Distance/RoutingModeResolver.php
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/modules/custom_webform_handlers/src/Distance/RoutingModeResolver.php
@@ -0,0 +1,39 @@
+<?php
+
+namespace Drupal\custom_webform_handlers\Distance;
+
+use Drupal\Core\Config\ConfigFactoryInterface;
+
+/**
+ * Resolves the effective routing mode for distance and offer calculations.
+ *
+ * Enforces development_fixed mode when running in DDEV environments.
+ */
+final class RoutingModeResolver {
+
+  public const MODE_DEVELOPMENT_FIXED = 'development_fixed';
+  public const MODE_LIVE_CACHED = 'live_cached';
+
+  public function __construct(
+    private readonly ConfigFactoryInterface $configFactory,
+  ) {}
+
+  /**
+   * Returns the effective routing mode.
+   *
+   * Checks IS_DDEV_PROJECT environment variable first before reading config.
+   */
+  public function effectiveMode(): string {
+    $isDdev = getenv('IS_DDEV_PROJECT');
+    if ($isDdev === 'true' || $isDdev === '1') {
+      return self::MODE_DEVELOPMENT_FIXED;
+    }
+
+    $config = $this->configFactory->get('custom_webform_handlers.settings');
+    return $config->get('routing_mode') ?? self::MODE_LIVE_CACHED;
+  }
+
+  /**
+   * Checks whether the effective routing mode is development_fixed.
+   */
+  public function isDevelopmentFixed(): bool {
+    return $this->effectiveMode() === self::MODE_DEVELOPMENT_FIXED;
+  }
+
+}
