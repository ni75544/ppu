+ * replanned Reservation names the exact rate policy it was priced under. Nullable
+ * like its snapshot peers and added only when absent, so existing rows and any
+ * site that already has the column are left untouched.
+ */
+function custom_webform_handlers_update_10046(): string {
+  $schema = \Drupal::database()->schema();
+  $table = 'custom_webform_handlers_dispatch_reservation';
+  $field = 'price_snapshot_version';
+  if (!$schema->tableExists($table)) {
+    return (string) t('The Dispatch Reservation table is not present, so no pricing-policy version column was added.');
