+/**
+ * Sets default routing mode to live_cached if absent.
+ */
+function custom_webform_handlers_update_10045(): string {
+  $config = \Drupal::configFactory()->getEditable('custom_webform_handlers.settings');
+  if ($config->get('routing_mode') !== NULL) {
+    return (string) t('Routing mode default already exists; nothing changed.');
+  }
+
+  $config->set('routing_mode', 'live_cached')->save();
+  return (string) t('Set default customer routing mode to live_cached.');
+}
+
+/**
+ * Adds pricing-policy version column to Dispatch Reservation price snapshots.
+ */
+function custom_webform_handlers_update_10046(): string {
+  $schema = \Drupal::database()->schema();
+  $table = 'custom_webform_handlers_dispatch_reservation';
+  $field = 'price_snapshot_version';
+
+  if (!$schema->tableExists($table)) {
+    return (string) t('Table does not exist; nothing changed.');
+  }
+
+  if ($schema->fieldExists($table, $field)) {
+    return (string) t('Pricing-policy version column already exists; nothing changed.');
+  }
+
+  $definition = custom_webform_handlers_schema()[$table]['fields'][$field];
+  $schema->addField($table, $field, $definition);
+
+  return (string) t('Added the pricing-policy version to Dispatch Reservation price snapshots.');
+}
