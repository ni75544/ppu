<?php

/**
 * @file
 * Install and update hooks for Custom Webform Handlers.
 */

use Drupal\Core\Config\InstallStorage;

/**
 * Implements hook_requirements().
 */
function custom_webform_handlers_requirements($phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $config = \Drupal::config('custom_webform_handlers.settings');
  $server_key_configured = (string) \Drupal\Core\Site\Settings::get('custom_webform_handlers_server_api_key', '') !== '';
  $browser_key_configured = (string) $config->get('google_maps_browser_api_key') !== '';
  $rate_version = trim((string) $config->get('quote.rate_version'));

  return [
    'custom_webform_handlers_server_key' => [
      'title' => t('Shipping quote server API key'),
      'value' => $server_key_configured ? t('Configured') : t('Missing'),
      'severity' => $server_key_configured ? REQUIREMENT_OK : REQUIREMENT_ERROR,
      'description' => $server_key_configured
        ? t('The server-side Google Routes key is available through Drupal settings.')
        : t('Configure custom_webform_handlers_server_api_key in settings.php before calculating routes.'),
    ],
    'custom_webform_handlers_browser_key' => [
      'title' => t('Shipping quote browser API key'),
      'value' => $browser_key_configured ? t('Configured') : t('Missing'),
      'severity' => $browser_key_configured ? REQUIREMENT_OK : REQUIREMENT_ERROR,
      'description' => $browser_key_configured
        ? t('The browser key is configured. Confirm HTTP-referrer restrictions in Google Cloud Console.')
        : t('Configure a restricted browser key for Maps JavaScript and Places autocomplete.'),
    ],
    'custom_webform_handlers_rate_version' => [
      'title' => t('Shipping quote rate version'),
      'value' => $rate_version !== '' ? $rate_version : t('Missing'),
      'severity' => $rate_version !== '' ? REQUIREMENT_OK : REQUIREMENT_WARNING,
      'description' => t('This version is stored with every authoritative quote for auditing.'),
    ],
  ];
}

/**
 * Implements hook_schema().
 */
function custom_webform_handlers_schema(): array {
  $schema = [];

  $schema['custom_webform_handlers_reservation'] = [
    'description' => 'Server-authoritative Webform time-slot holds and reservations.',
    'fields' => [
      'reservation_id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'webform_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'resource_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE, 'default' => 'default'],
      'slot_start' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'slot_end' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'timezone' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'state' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE],
      'active_slot_key' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'hold_token_hash' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'owner_hash' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'submission_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'expires_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['reservation_id'],
    'unique keys' => ['reservation_active_slot' => ['active_slot_key']],
    'indexes' => [
      'reservation_expiry' => ['state', 'expires_at'],
      'reservation_submission' => ['submission_id'],
      'reservation_availability' => ['webform_id', 'resource_id', 'slot_start'],
    ],
  ];

  // Dispatch Reservations.
  //
  // Deliberately without a unique key on any slot identifier. The older table
  // above resolves contention with a unique active_slot_key, which works only
  // because every claim there is the same fixed length. A Dispatch Window has a
  // variable duration derived from route and work time, so two non-identical
  // start times can still overlap and no single-column key can express that.
  // Serialization comes from the Resource Calendar Guard row locks instead.
  $schema['custom_webform_handlers_dispatch_reservation'] = [
    'description' => 'Dispatch Reservations: held and confirmed claims on a Resource, with the derived Dispatch Window they occupy.',
    'fields' => [
      'dispatch_reservation_id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'resource_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'webform_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'submission_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'state' => ['type' => 'varchar_ascii', 'length' => 16, 'not null' => TRUE],
      // Pickup arrival: the Slot instant, in UTC.
      'pickup_arrival' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // The zone the visitor read the pickup time in. Never reinterpreted.
      'timezone' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      // The derived Dispatch Window. Overlap is decided on these two columns
      // alone, in UTC, so a malformed stored timezone cannot weaken safety.
      'window_start' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'window_end' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // Repositioning space this claim requires on either side of its window.
      'inbound_reposition_seconds' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'outbound_reposition_seconds' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      // Snapshots. What was true when the claim was made, kept verbatim so a
      // later configuration change cannot rewrite history.
      'pickup_location' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'delivery_location' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'route_seconds' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'route_meters' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'price_snapshot_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => FALSE],
      'price_snapshot_cents' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'price_snapshot_currency' => ['type' => 'varchar_ascii', 'length' => 3, 'not null' => FALSE],
      // The Commerce order this capacity was paid through, once one exists.
      //
      // Nullable and never unique. Nullable because a Hold has not been paid for
      // and staff claims are never paid for at all, and because history predates
      // Commerce entirely. Not unique because a Replan writes a second confirmed
      // row for the same job — moving the van does not change who paid for it — so
      // one order legitimately names the row it started at and the row it moved to.
      //
      // A pointer, not an authority. Nothing reads this column to decide whether
      // time is free; the Resource Calendar Guard transaction decides that.
      'order_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      // Secrets are stored only as SHA-256 hashes, never as raw values.
      'hold_token_hash' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'owner_hash' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      'expires_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['dispatch_reservation_id'],
    'indexes' => [
      // The overlap query: one Resource, live states, ordered by window.
      'dispatch_overlap' => ['resource_id', 'state', 'window_start', 'window_end'],
      'dispatch_expiry' => ['state', 'expires_at'],
      'dispatch_token' => ['hold_token_hash'],
      'dispatch_submission' => ['submission_id'],
      'dispatch_webform' => ['webform_id'],
      // Answering "which capacity did this order buy" without scanning. Payment
      // confirmation is idempotent and synchronous, so this lookup is on the path
      // of every repeated payment notification.
      'dispatch_order' => ['order_id'],
    ],
  ];

  // Resource Calendar Guards.
  //
  // These rows carry almost no data and exist to be locked. One row per Resource
  // and local service day gives the planner a stable, orderable set of row locks
  // to take before it reads the schedule, which is what turns "read then write"
  // into one serialized operation.
  $schema['custom_webform_handlers_dispatch_guard'] = [
    'description' => 'Resource Calendar Guards: one lockable row per Resource and local service day.',
    'fields' => [
      'guard_id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'resource_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'local_date' => ['type' => 'varchar_ascii', 'length' => 10, 'not null' => TRUE],
      // Set when a day carries an active legacy claim whose feasibility cannot
      // be proven. Such a day is withheld from self-booking until an
      // administrator reconciles it; no route is ever invented for it.
      'legacy_unplanned' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'legacy_note' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['guard_id'],
    'unique keys' => ['guard_resource_date' => ['resource_id', 'local_date']],
    'indexes' => ['guard_legacy' => ['legacy_unplanned']],
  ];

  // Resource Blackouts.
  $schema['custom_webform_handlers_dispatch_blackout'] = [
    'description' => 'Resource Blackouts: administrative intervals during which a Resource is unavailable.',
    'fields' => [
      'blackout_id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'resource_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'start_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'end_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'reason' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      // Withdrawn blackouts are kept for audit and stop consuming capacity.
      'status' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['blackout_id'],
    'indexes' => [
      'blackout_window' => ['resource_id', 'status', 'start_at', 'end_at'],
    ],
  ];

  // Reported Resource Status.
  //
  // Insert-only, and deliberately carrying no foreign key to the Reservation table:
  // a report names the job it was about, but it is an observation and has to keep
  // meaning something after that row is released. Nothing in the planner reads this
  // table, so there is no index here for a capacity query. The only two reads are
  // "the latest for this Resource" and "the last few", which is what the index
  // serves; a status is never consulted to decide whether time is free.
  $schema['custom_webform_handlers_dispatch_status'] = [
    'description' => 'Reported Resource Status: what staff observed about a Resource, kept as history.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'resource_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'state' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      // The job a report is about, for the four states that name one. NULL for the
      // two that are about the vehicle itself.
      'dispatch_reservation_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'note' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      // Both halves of the audit are stored. An account can be renamed or removed,
      // and the name it had when the report was filed is what keeps this row
      // readable afterwards.
      'actor_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'actor_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'recorded_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // Marks this as a human assertion made under a permission check, so a driver
      // application or telematics feed added later is distinguishable in storage
      // rather than by inference from the day it started arriving.
      'source' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => ['status_resource_recorded' => ['resource_id', 'recorded_at']],
  ];

  // Notification attempts.
  //
  // What was announced, and never what was written. There is no recipient column and
  // no body column, which is what makes this history safe to put on an
  // administrative page and safe to appear in a database dump: it discloses no
  // address a customer gave us and no sentence they read.
  //
  // Written by the queue worker after the fact, so no row here is ever inserted on a
  // capacity transaction's path or while a Resource Calendar Guard is held.
  $schema['custom_webform_handlers_dispatch_notification'] = [
    'description' => 'Dispatch notification attempts: outcomes and identifiers, with no recipient or message body.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'event' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'audience' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      'channel' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      'outcome' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      'resource_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'dispatch_reservation_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'submission_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      // Two timestamps, because the gap between them is how long the announcement
      // waited for cron. An operator asking why a customer heard late is asking
      // about that gap, and one column could not answer it.
      'occurred_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'recorded_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // Why an attempt failed or was skipped, clipped by the log before it is
      // written. Never a recipient and never a message.
      'detail' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'notification_resource_recorded' => ['resource_id', 'recorded_at'],
      'notification_reservation' => ['dispatch_reservation_id'],
    ],
  ];

  // Notification claims.
  //
  // The mutual exclusion that stops one announcement being sent twice. A separate
  // table from the history above rather than a column on it, because the two have
  // opposite lifecycles: the history is insert-only and describes what already
  // happened, while a claim is taken before anything happens and is given back if the
  // transport refuses. Putting both in one table would have meant either an UPDATE on
  // a table documented as never taking one, or a placeholder outcome row that reads as
  // needing attention forever when a worker dies mid-send.
  //
  // The unique key is the entire point. Advanced Queue can hand the same job to a
  // second worker — a lease expires while the first is still running, or a worker
  // sends its mail and dies before reporting success — so "have we sent this already"
  // has to be answered by the database refusing a row, not by application code reading
  // and then writing.
  //
  // (idempotency_key, audience) rather than the key alone, because the two audiences
  // of one event are independent facts: a staff copy that was refused must stay
  // retryable after the customer copy was accepted.
  //
  // Nothing identifying. A hash, an audience word and a timestamp — no submission, no
  // Reservation, no recipient — so this table cannot say whose booking a row concerns.
  // That is stricter than the history beside it and appropriate for a row whose whole
  // meaning is "taken".
  $schema['custom_webform_handlers_dispatch_notify_claim'] = [
    'description' => 'Notification send claims: one row per announcement per audience, holding no identifying data.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      // sha256 hex of the queue payload. 64 characters exactly; see
      // DispatchNotification::idempotencyKey().
      'idempotency_key' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      // The DispatchAudience case, matching the history table's column width.
      'audience' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      // When the claim was taken. Read only by the retention prune, which is manual.
      'claimed_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'notify_claim_key_audience' => ['idempotency_key', 'audience'],
    ],
    'indexes' => [
      // The prune's only predicate, ordered by the primary key it then deletes on.
      'notify_claim_claimed' => ['claimed_at'],
    ],
  ];

  // Checkout Attempts.
  //
  // The private lifecycle of one attempt to pay for one Slot. It exists as a table
  // rather than as fields on the Commerce order for one reason: every invariant it
  // carries is a uniqueness invariant, and the Field API cannot declare a unique
  // index. A check in PHP is not the same guarantee when two payment notifications
  // arrive at once.
  //
  // So the three unique keys below are the justification for the table, and
  // everything else in it is a snapshot the lifecycle must be able to read back
  // without asking another system what it used to say. Commerce still owns the
  // order, its state machine, its mail, its receipts, and its payments.
  //
  // There is no contact column, no request payload, and no token or hash. The
  // submission identifier is how the facts are reached, so they stay in the one
  // place that can still be re-normalised when feasibility is re-proved.
  $schema['custom_webform_handlers_checkout_attempt'] = [
    'description' => 'Private Checkout Attempts: the payment lifecycle for one Slot, with no contact detail and no secrets.',
    'fields' => [
      'attempt_id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      // The canonical Commerce order this attempt pays through.
      'order_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // The originating job. Written from the saved submission, never from a
      // browser, which is what makes the link server-owned.
      'webform_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'submission_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // The selected Slot, stored as the three facts a Slot is built from, so the
      // local pickup reading the visitor saw can be reproduced exactly even if the
      // Resource Profile's zone is changed afterwards.
      'resource_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'pickup_arrival' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'timezone' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      // The locked amount payment began against. Copied from the server's own
      // quote; there is no path by which a browser sets it.
      'quote_snapshot_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'quote_amount_cents' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'quote_currency' => ['type' => 'varchar_ascii', 'length' => 3, 'not null' => TRUE],
      'quote_rate_version' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      // pending, paid, failed, cancelled, or reconciliation_required.
      'state' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      // Derived from the job, the Slot, and the price — never supplied by a caller.
      // Nullable because settling to anything but paid releases the intent, so a
      // declined card or an abandoned checkout can be retried; a paid attempt keeps
      // its key forever, which is the case the unique index exists for.
      'idempotency_key' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => FALSE],
      // The internal Dispatch row this attempt confirmed. Never published.
      'dispatch_reservation_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'settled' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['attempt_id'],
    // One attempt per order, one per intent, one per Dispatch row. The last two
    // are nullable, and MariaDB allows repeated NULLs in a unique index, which is
    // what lets a released intent and an unconfirmed attempt coexist freely.
    'unique keys' => [
      'attempt_order' => ['order_id'],
      'attempt_intent' => ['idempotency_key'],
      'attempt_reservation' => ['dispatch_reservation_id'],
    ],
    // The one lookup that is not a unique key: the attempt still in flight for a
    // job, asked before any Hold is taken so a double-clicked pay button is
    // answered with the order it already opened.
    'indexes' => ['attempt_submission' => ['submission_id', 'state']],
  ];

  // Review Requests.
  //
  // The authoritative lifecycle of one job a human has to price. A table for the
  // same reason the Checkout Attempt is one: its invariants are uniqueness
  // invariants, and the Field API cannot declare a unique index. One job has one
  // review and one tracking code names one request, and both of those are indexes
  // below rather than checks in PHP — which is what holds when two members of staff
  // decide at once.
  //
  // The second reason is disclosure. A submission's element values are visible
  // wherever the submission is, and the tracking credential must not be, so it is
  // stored here and stored hashed. There is no raw token column and no column that
  // could be reversed into one.
  //
  // What this table does not hold: any contact detail, any address, any route fact,
  // and any capacity fact of its own. order_id and dispatch_reservation_id are
  // pointers to rows Commerce and the Resource Calendar Guard own; writing one here
  // records that they exist and decides nothing about them.
  $schema['custom_webform_handlers_review_request'] = [
    'description' => 'Review Requests: the staff pricing lifecycle for one job, with no contact detail and no raw credential.',
    'fields' => [
      'review_id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      // The originating job. Written from the saved submission, never a browser.
      'webform_id' => ['type' => 'varchar_ascii', 'length' => 128, 'not null' => TRUE],
      'submission_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // submitted, under_review, approved, scheduled, declined, cancelled, expired.
      // A value nothing recognises is refused on read rather than defaulted, because
      // an unreadable state must never be treated as open work.
      'state' => ['type' => 'varchar_ascii', 'length' => 32, 'not null' => TRUE],
      // The Commerce order the offer was paid through, and the Dispatch row the guard
      // committed. Both nullable, and both only ever written by recordScheduled().
      'order_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'dispatch_reservation_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      // The authoritative quote a member of staff prepared, in minor units. Nullable
      // because a request has no price until somebody approves it, and written in the
      // same statement that moves the state so it is never approved and unpriced.
      'quote_amount_cents' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'quote_currency' => ['type' => 'varchar_ascii', 'length' => 3, 'not null' => FALSE],
      // What staff wrote for this customer. Normalised and bounded before storage, so
      // the tracker renders it as the plain text it is.
      'staff_message' => ['type' => 'varchar', 'length' => 1000, 'not null' => TRUE, 'default' => ''],
      // The tracking credential, as an HMAC keyed by the site private key and hash
      // salt — both outside this database. A leaked table yields no working link.
      // Never selected into a value object and never rendered.
      'lookup_hash' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      // Who decided. The name is kept alongside the uid because an account can be
      // renamed or deleted and the audit trail must still say who approved a job.
      'actor_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'actor_name' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      // When it left an open state, and when its offer lapses. decided_at is stamped
      // for expiry too: an operator looking at a lapsed request needs to know when it
      // lapsed, not only when it arrived.
      'decided_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'expires_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['review_id'],
    // One review per job, one request per tracking code. The first is what makes
    // opening a review idempotent; the second is what makes a code unambiguous.
    'unique keys' => [
      'review_submission' => ['submission_id'],
      'review_credential' => ['lookup_hash'],
    ],
    // The queue read, oldest first, and the expiry sweep. Both are state-first
    // because both begin by excluding the states they must never touch.
    'indexes' => [
      'review_queue' => ['state', 'created'],
      'review_expiry' => ['state', 'expires_at'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 *
 * The first-install bootstrap, and deliberately not a migration.
 *
 * Drupal does not run a single hook_update_N on a fresh module install: it stamps the
 * schema version at the highest one it finds and skips them all. Everything updates
 * 10001-10039 did for the site that grew this module has to be true of a new database
 * on the strength of hook_schema() and config/install alone — which it now is, with one
 * exception that configuration is structurally incapable of carrying.
 *
 * A Commerce Store is a content entity. config/install ships the Dispatch order type,
 * the checkout flow, the order fields and the Webform, and a site with all of them
 * still refuses every booking, because DispatchOrderFactory asks CurrentStore which
 * shop the order belongs to and gets NULL. Nothing else here is missing, so nothing
 * else is created: the Advanced Queue queues arrive on their own through config/optional
 * whichever order the two modules are installed in, and the planner tables are
 * hook_schema()'s job.
 *
 * The work is done by a service so it can take Commerce's currency importer by
 * injection, and it is idempotent: it creates a store only when there are none, and
 * never edits one it finds. See CommerceStoreInstaller for why an existing store is
 * left exactly as it is.
 *
 * Runs on a configuration sync too. $is_syncing suppresses config work, and this is
 * not config work — a synced site imports the same packaged objects and would be left
 * with the same missing store.
 *
 * @see \Drupal\custom_webform_handlers\Install\CommerceStoreInstaller
 */
function custom_webform_handlers_install($is_syncing): void {
  $outcome = \Drupal::service('custom_webform_handlers.store_installer')->ensureStore();
  \Drupal::logger('custom_webform_handlers')->info('Dispatch install completed its Commerce store bootstrap: @outcome.', ['@outcome' => $outcome]);
}

/**
 * Removes the legacy API key that was shared by browser and server requests.
 */
function custom_webform_handlers_update_10001(): string {
  $config = \Drupal::configFactory()
    ->getEditable('custom_webform_handlers.settings');

  $config
    ->clear('google_maps_api_key')
    ->set('google_maps_browser_api_key', '')
