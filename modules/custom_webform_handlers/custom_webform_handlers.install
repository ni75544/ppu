/**
 * Creates the reservation table that makes double booking impossible.
 */
function custom_webform_handlers_update_10008(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('custom_webform_handlers_reservation')) {
    return t('The reservation table already exists. No changes were made.');
  }

  $tables = custom_webform_handlers_schema();
  $schema->createTable('custom_webform_handlers_reservation', $tables['custom_webform_handlers_reservation']);

  return t('Created the reservation table. Its unique active_slot_key is the only authority that resolves competing holds; enable the reservation settings on the Address and Distance Calculator handler to start using it.');
}

/**
 * Installs the Dispatch Planner operating profile.
 *
 * The module is already installed, so config/install is never replayed for it.
 * The values are read out of that YAML rather than restated here, so the shipped
 * defaults have exactly one definition and no hour, buffer, or limit is ever
 * hard-coded in PHP.
 */
function custom_webform_handlers_update_10009(): string {
  $name = 'custom_webform_handlers.dispatch';
  $config = \Drupal::configFactory()->getEditable($name);

  if (!$config->isNew()) {
    return t('The Dispatch Planner profile already exists. No changes were made.');
  }

  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);
  $data = $source->read($name);

  if (!is_array($data)) {
    throw new \Drupal\Core\Utility\UpdateException(sprintf('The default configuration %s.yml could not be read from %s.', $name, $directory));
  }

  $config->setData($data)->save();

  return t('Installed the Dispatch Planner operating profile for Resource @resource. Review it at Administration, Configuration, Web services, Dispatch Planner settings; the depot address is intentionally empty and must be set before return-to-base can be evaluated.', [
    '@resource' => (string) ($data['resource']['id'] ?? 'unknown'),
  ]);
}

/**
 * Adds dispatch storage and flags legacy Resource days as unplanned.
 *
 * Idempotent in both halves: tables are created only when absent, and the legacy
 * scan writes guard rows through a merge, so re-running changes nothing.
 *
 * The older custom_webform_handlers_reservation table is read and never written.
 * It is not deleted, migrated, or reinterpreted: it has no route or duration
 * columns at all, so no row in it can prove a feasible Dispatch Window. Rather
 * than invent a route, every local day carrying an active legacy claim is flagged
 * legacy-unplanned and withheld from self-booking until an administrator
 * reconciles it.
 */
function custom_webform_handlers_update_10010(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  $now = \Drupal::time()->getRequestTime();
  $tables = custom_webform_handlers_schema();

  $created = [];
  foreach ([
    'custom_webform_handlers_dispatch_reservation',
    'custom_webform_handlers_dispatch_guard',
    'custom_webform_handlers_dispatch_blackout',
  ] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $tables[$table]);
      $created[] = $table;
    }
  }

  // Flag the local days of active legacy claims.
  $flagged = 0;
  $ambiguous = 0;
  if ($schema->tableExists('custom_webform_handlers_reservation')) {
    $query = $database->select('custom_webform_handlers_reservation', 'r')
      ->fields('r', ['reservation_id', 'resource_id', 'slot_start', 'timezone', 'state', 'expires_at']);
    // Active means held-and-unexpired or confirmed. Everything else is history
    // and consumes no capacity, so it needs no guard.
    $active = $query->orConditionGroup()
      ->condition('r.state', 'confirmed')
      ->condition($query->andConditionGroup()
        ->condition('r.state', 'held')
        ->condition('r.expires_at', $now, '>'));
    $query->condition($active);

    foreach ($query->execute() as $row) {
      $zone = NULL;
      try {
        $zone = new \DateTimeZone((string) $row->timezone);
      }
      catch (\Exception) {
        $zone = NULL;
      }

      if ($zone !== NULL) {
        $dates = [
          (new \DateTimeImmutable('@' . (int) $row->slot_start))->setTimezone($zone)->format('Y-m-d'),
        ];
        $note = 'Legacy reservation ' . (int) $row->reservation_id . ' has no route data to prove a feasible Dispatch Window.';
      }
      else {
        // The stored zone is unreadable, so the true local date is unknown. UTC
        // is not substituted: that would silently move the day. Instead the UTC
        // day and both neighbours are flagged, which over-blocks rather than
        // leaving a real claim unguarded.
        $utc = new \DateTimeZone('UTC');
        $anchor = (new \DateTimeImmutable('@' . (int) $row->slot_start))->setTimezone($utc);
        $dates = [
          $anchor->modify('-1 day')->format('Y-m-d'),
          $anchor->format('Y-m-d'),
          $anchor->modify('+1 day')->format('Y-m-d'),
        ];
        $note = 'Legacy reservation ' . (int) $row->reservation_id . ' has an unreadable stored timezone; adjacent days flagged conservatively.';
        $ambiguous++;
      }

      foreach ($dates as $date) {
        $database->merge('custom_webform_handlers_dispatch_guard')
          ->keys([
            'resource_id' => (string) $row->resource_id,
            'local_date' => $date,
          ])
          ->fields([
            'legacy_unplanned' => 1,
            'legacy_note' => mb_substr($note, 0, 255),
            'changed' => $now,
          ])
          ->insertFields([
            'resource_id' => (string) $row->resource_id,
            'local_date' => $date,
            'legacy_unplanned' => 1,
            'legacy_note' => mb_substr($note, 0, 255),
            'created' => $now,
            'changed' => $now,
          ])
          ->execute();
        $flagged++;
      }
    }
  }

  return t('Dispatch storage ready. Tables created: @created. Legacy Resource days flagged unplanned: @flagged (@ambiguous with an unreadable stored timezone, flagged conservatively across adjacent days). The legacy reservation table was read only and left untouched; flagged days stay closed to self-booking until reconciled.', [
    '@created' => $created ? implode(', ', $created) : 'none, all already present',
    '@flagged' => $flagged,
    '@ambiguous' => $ambiguous,
  ]);
}

/**
 * Adds the reported-status and notification-history tables.
 *
 * Both hold integration history that sits beside the schedule and proves nothing
 * about capacity, so this update creates tables and touches nothing else: no
 * Reservation is re-read, no Resource Calendar Guard is written, and no existing
 * configuration is changed. Idempotent — a table is created only when absent.
 */
function custom_webform_handlers_update_10011(): string {
  $schema = \Drupal::database()->schema();
  $tables = custom_webform_handlers_schema();

  $created = [];
  foreach ([
    'custom_webform_handlers_dispatch_status',
    'custom_webform_handlers_dispatch_notification',
  ] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $tables[$table]);
      $created[] = $table;
    }
  }

  return t('Dispatch integration storage ready. Tables created: @created. Neither table informs capacity: a reported status withholds no time and moves no booking, and the notification history records outcomes and identifiers only, never a recipient address or a message body.', [
    '@created' => $created ? implode(', ', $created) : 'none, all already present',
  ]);
}

/**
 * Installs the shipped dispatch notification settings.
 *
 * Same situation as update 10009, and the same mechanism: the module is already
 * installed, so config/install is never replayed for it, and the values are read
 * out of that YAML rather than restated here so the shipped defaults keep exactly
 * one definition and no template or recipient is hard-coded in PHP.
 *
 * The shipped defaults announce nothing. Whether the site writes to customers, and
 * which address staff copies go to, are decisions an update hook has no business
 * making on an operator's behalf: turning on outbound mail to real addresses during
 * a database update is exactly the surprise this leaves switched off.
 */
function custom_webform_handlers_update_10012(): string {
  $name = 'custom_webform_handlers.notifications';
  $config = \Drupal::configFactory()->getEditable($name);

  if (!$config->isNew()) {
    return t('The dispatch notification settings already exist. No changes were made.');
  }

  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);
  $data = $source->read($name);

  if (!is_array($data)) {
    throw new \Drupal\Core\Utility\UpdateException(sprintf('The default configuration %s.yml could not be read from %s.', $name, $directory));
  }

  $config->setData($data)->save();

  return t('Installed the dispatch notification settings, switched off. Nothing is announced until you enable it at Administration, Configuration, Web services, Dispatch Notifications, and the staff address is intentionally empty: with no address, a staff copy is recorded as not sent rather than guessed at. Messages are composed and sent on cron, never inside a booking.');
}

/**
 * Repairs missing and invalid active dispatch configuration.
 *
 * Updates 10009-10012 brought the planner's schema. Its active configuration on
 * a site that has been used for testing can still be narrower than the shipped
 * profile and can carry values that match nothing, so this update closes that
 * gap once and idempotently. It is deliberately conservative in two directions.
 *
 * It seeds a shipped default only where the active object holds no value at that
 * path, so a considered local override survives. Two paths are never seeded at
 * all - resource.working_hours and resource.breaks - because a default written
 * there would invent business hours for a real Resource. A Resource with no
 * working hours offers no Slots, which is the safe reading of silence. Nothing
 * here writes a depot address, a notification recipient, or a price.
 *
 * It then enforces the few values the product treats as invariants rather than
 * preferences: Express Courier is the only self-bookable service, and "courier"
 * is the canonical machine value behind that public label; one Resource serves
 * one Dispatch Window at a time; the declared-weight and single-driver
 * questions must be answered before work can self-book, because they are what
 * the weight ceiling is checked against; that ceiling is 30 lb; and a Hold
 * lasts a positive number of seconds. Each is repaired only when the stored
 * value is absent or cannot be honoured, so a stricter local value - a lower
 * weight ceiling, for instance - is left alone.
 *
 * holds.hold_seconds is internal. It governs how long the server holds capacity
 * and is never rendered; no public countdown, Hold-expiry field, or timezone
 * selector is added here. Display and calculation defaults stay
 * America/New_York while stored instants stay UTC.
 */
function custom_webform_handlers_update_10013(): string {
  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);
  $messages = [];

  // Paths whose shipped value is real schedule data rather than a policy
  // default. Seeding either one would invent business hours.
  $never_seed = [
    'resource.working_hours',
    'resource.breaks',
  ];

  foreach (['custom_webform_handlers.dispatch', 'custom_webform_handlers.notifications'] as $name) {
    $shipped = $source->read($name);
    if (!is_array($shipped)) {
      throw new \Drupal\Core\Utility\UpdateException(sprintf('The default configuration %s.yml could not be read from %s.', $name, $directory));
    }

    $config = \Drupal::configFactory()->getEditable($name);
    if ($config->isNew()) {
      $config->setData($shipped)->save();
      $messages[] = (string) t('@name was absent and was installed from the shipped defaults.', ['@name' => $name]);
      continue;
    }

    $original = $config->getRawData();
    $seeded = [];
    $repaired = [];
    $data = _custom_webform_handlers_seed_absent($original, $shipped, '', $never_seed, $seeded);
    $data = $name === 'custom_webform_handlers.dispatch'
      ? _custom_webform_handlers_enforce_dispatch_invariants($data, $shipped, $repaired)
      : _custom_webform_handlers_enforce_notification_defaults($data, $repaired);

    if ($data === $original) {
      $messages[] = (string) t('@name already held every shipped default and satisfied every invariant. No changes were made.', ['@name' => $name]);
      continue;
    }

    $config->setData($data)->save();
    $messages[] = (string) t('@name updated. Defaults seeded: @seeded. Values corrected: @repaired.', [
      '@name' => $name,
      '@seeded' => $seeded ? implode(', ', $seeded) : 'none',
      '@repaired' => $repaired ? implode(', ', $repaired) : 'none',
    ]);
  }

  $dispatch = \Drupal::config('custom_webform_handlers.dispatch');
  if ($dispatch->get('resource.return_to_base') && trim((string) $dispatch->get('resource.depot_address')) === '') {
    $messages[] = (string) t('Operator action: this Resource must return to base but has no depot address, so the planner offers no Slots at all until an administrator adds one. No address was invented here.');
  }
  if (!$dispatch->get('resource.working_hours')) {
    $messages[] = (string) t('Operator action: this Resource has no working hours, so the planner offers no Slots until an administrator sets them. None were invented here.');
  }

  return implode(' ', $messages);
}

/**
 * Adds the Commerce order reference, the Checkout Attempt table, and its config.
 *
 * Three idempotent steps, each of which checks what is already there rather than
 * assuming a starting point, so the update can be re-run and so a site that has
 * been through only part of it is repaired rather than broken.
 *
 * The specifications are read from custom_webform_handlers_schema() rather than
 * repeated here. A fresh install and an updated install then cannot drift: there
 * is one definition of the order reference and one of the attempt table, and this
 * hook applies it to a database that predates both.
 *
 * No existing column, index, or row is altered. The submission reference stays
 * exactly as it is, historical fixed-slot and Dispatch rows are untouched, and the
 * new order reference is nullable precisely so that history needs no backfill —
 * there is no order to name for capacity claimed before Commerce existed here.
 */
function custom_webform_handlers_update_10014(): string {
  $messages = [];
  $schema = \Drupal::database()->schema();
  $definitions = custom_webform_handlers_schema();

  $reservations = 'custom_webform_handlers_dispatch_reservation';
  if (!$schema->tableExists($reservations)) {
    throw new \Drupal\Core\Utility\UpdateException(sprintf('The table %s is absent, so this update cannot extend it. An earlier update has not run.', $reservations));
  }

  if ($schema->fieldExists($reservations, 'order_id')) {
    $messages[] = (string) t('The Dispatch Reservation order reference was already present.');
  }
  else {
    $schema->addField($reservations, 'order_id', $definitions[$reservations]['fields']['order_id']);
    $messages[] = (string) t('Added the nullable Commerce order reference to Dispatch Reservations.');
  }

  // Non-unique deliberately. A Replan writes a second confirmed row for the same
  // job and carries the order forward, so one order names more than one row.
  if ($schema->indexExists($reservations, 'dispatch_order')) {
    $messages[] = (string) t('The Dispatch Reservation order index was already present.');
  }
  else {
    $schema->addIndex($reservations, 'dispatch_order', ['order_id'], $definitions[$reservations]);
    $messages[] = (string) t('Added the dispatch_order index for idempotent payment lookups.');
  }

  $attempts = 'custom_webform_handlers_checkout_attempt';
  if ($schema->tableExists($attempts)) {
    $messages[] = (string) t('The private Checkout Attempt table was already present.');
  }
  else {
    $schema->createTable($attempts, $definitions[$attempts]);
    $messages[] = (string) t('Created the private Checkout Attempt table with one attempt per order, per intent, and per Dispatch row.');
  }

  $messages[] = _custom_webform_handlers_install_commerce_types();

  return implode(' ', $messages);
}

/**
 * Seeds the Express Courier rate and duration defaults into active config.
 *
 * config/install is read once, when a module is first installed. Task 4 added
 * quote.courier to custom_webform_handlers.settings and three new keys to
 * durations.courier, so on a site that already had this module those values exist
 * only in a file nothing reads. Two consequences, both real rather than
 * theoretical:
 *
 * - quote.courier was absent outright, so Express Courier had no rate at all.
 *   Worse than the absence: the Shipping Quote Settings form reads its defaults
 *   from that config and replaces the whole quote key on save, so the first
 *   administrator to open and save the form would have written zero to every
 *   Express Courier rate and produced a free courier service.
 * - durations.courier held only the pickup and delivery dwell, because
 *   update_10013 ran before the Store Pickup dwell, operational buffer, and
 *   promise width existed. Those three read as 0, which the duration policy
 *   correctly treats as "fall back", so nothing broke - but the mode-specific
 *   Store Pickup dwell silently did nothing.
 *
 * Only those two subtrees are seeded. Passing whole shipped files to the seeding
 * helper, as update_10013 does for its own scope, would reinstate keys belonging
 * to other tasks and undo an operator who deliberately removed a rate elsewhere.
 *
 * Absent-only, so an operator's own courier figures survive: the two dwell times
 * already set here stay at whatever they were, and only the genuinely missing keys
 * are filled. Re-running seeds nothing a second time.
 *
 * quote.rate_version is deliberately not touched. It describes the rates that
 * produced a stored total, and no stored total can name an Express Courier rate
 * that did not exist - the elements to request one arrived in this same task. The
 * non-courier rates are untouched here, so the existing version stays honest.
 */
function custom_webform_handlers_update_10015(): string {
  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);
  $messages = [];

  // Dotted path of the one subtree each object should receive.
  $subtrees = [
    'custom_webform_handlers.settings' => ['quote', 'courier'],
    'custom_webform_handlers.dispatch' => ['durations', 'courier'],
  ];

  foreach ($subtrees as $name => $path) {
    $shipped = $source->read($name);
    if (!is_array($shipped)) {
      throw new \Drupal\Core\Utility\UpdateException(sprintf('The default configuration %s.yml could not be read from %s.', $name, $directory));
    }

    $config = \Drupal::configFactory()->getEditable($name);
    if ($config->isNew()) {
      // Nothing to merge into. A subtree on its own would be a config object
      // holding Express Courier and nothing else, so the whole file installs.
      $config->setData($shipped)->save();
      $messages[] = (string) t('@name was absent and was installed from the shipped defaults.', ['@name' => $name]);
      continue;
    }

    // Narrow the shipped data to the single subtree, then rebuild its parents so
    // the seeding helper walks the same shape as the active object.
    $branch = $shipped;
    foreach ($path as $step) {
      if (!is_array($branch[$step] ?? NULL)) {
        throw new \Drupal\Core\Utility\UpdateException(sprintf('The shipped %s is missing %s, so this update has nothing to seed.', $name, implode('.', $path)));
      }
      $branch = $branch[$step];
    }
    foreach (array_reverse($path) as $step) {
      $branch = [$step => $branch];
    }

    $original = $config->getRawData();
    $seeded = [];
    $data = _custom_webform_handlers_seed_absent($original, $branch, '', [], $seeded);

    if ($data === $original) {
      $messages[] = (string) t('@name already held every Express Courier default at @path. No changes were made.', [
        '@name' => $name,
        '@path' => implode('.', $path),
      ]);
      continue;
    }

    $config->setData($data)->save();
    $messages[] = (string) t('@name updated. Express Courier defaults seeded: @seeded.', [
      '@name' => $name,
      '@seeded' => implode(', ', $seeded),
    ]);
  }

  $messages[] = (string) t('Review the seeded Express Courier rates at Shipping Quote Settings before production use. They are provisional figures like every other rate in this module, not approved prices.');

  return implode(' ', $messages);
}

/**
 * Installs the dispatch order and order-item types if they are not already there.
 *
 * Read from this module's own config/install rather than written out again here,
 * and created through the entity API rather than through the config factory, so
 * Commerce calculates the dependencies and validates the bundle exactly as it
 * would on a fresh install. An existing type is never overwritten: an operator may
 * have changed the receipt subject or the refresh mode, and this update has no
 * business reverting that.
 */
function _custom_webform_handlers_install_commerce_types(): string {
  if (!\Drupal::moduleHandler()->moduleExists('commerce_order')) {
    // Not an error to fail the update over. Commerce Order is declared as a module
    // dependency, so this is only reachable on a site mid-way through enabling it,
    // and the config will install with the module.
    return (string) t('Commerce Order is not enabled, so the dispatch order types were not created.');
  }

  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);
  $created = [];
  $present = [];

  $types = [
    'commerce_order_type' => 'commerce_order.commerce_order_type.dispatch',
    'commerce_order_item_type' => 'commerce_order.commerce_order_item_type.dispatch_service',
  ];

  foreach ($types as $entityTypeId => $name) {
    $shipped = $source->read($name);
    if (!is_array($shipped) || !isset($shipped['id'])) {
      throw new \Drupal\Core\Utility\UpdateException(sprintf('The default configuration %s.yml could not be read from %s.', $name, $directory));
    }

    $storage = \Drupal::entityTypeManager()->getStorage($entityTypeId);
    if ($storage->load($shipped['id']) !== NULL) {
      $present[] = $name;
      continue;
    }

    $storage->create($shipped)->save();
    $created[] = $name;
  }

  return (string) t('Dispatch Commerce types created: @created. Already present: @present.', [
    '@created' => $created ? implode(', ', $created) : 'none',
    '@present' => $present ? implode(', ', $present) : 'none',
  ]);
}

/**
 * Writes shipped defaults into active configuration only where none exists.
 *
 * @param array $active
 *   The active configuration data at this level.
 * @param array $shipped
 *   The shipped default data at the same level.
 * @param string $path
 *   Dotted path of this level, empty at the root.
 * @param array $never_seed
 *   Dotted paths that must be left exactly as the operator left them.
 * @param array $seeded
 *   Collects the dotted paths that received a default, for the update message.
 *
 * @return array
 *   The active data with absent defaults filled in.
 */
function _custom_webform_handlers_seed_absent(array $active, array $shipped, string $path, array $never_seed, array &$seeded): array {
  foreach ($shipped as $key => $value) {
    $child = $path === '' ? (string) $key : $path . '.' . $key;
    if (in_array($child, $never_seed, TRUE)) {
      continue;
    }

    if (!array_key_exists($key, $active) || $active[$key] === NULL) {
      $active[$key] = $value;
      $seeded[] = $child;
      continue;
    }

    // Recurse into mappings only. A shipped sequence is a whole answer, so
    // merging it item by item would silently rewrite an operator's own list.
    if (is_array($value) && is_array($active[$key]) && !array_is_list($value)) {
      $active[$key] = _custom_webform_handlers_seed_absent($active[$key], $value, $child, $never_seed, $seeded);
    }
  }

  return $active;
}

/**
 * Leaves notification settings switched off and unaddressed unless configured.
 *
 * A missing or non-boolean switch reads as off, and a missing recipient reads as
 * empty. Neither is guessed at: with no address, a staff copy is recorded as not
 * sent rather than sent somewhere nobody chose.
 */
function _custom_webform_handlers_enforce_notification_defaults(array $data, array &$repaired): array {
  if (!is_bool($data['enabled'] ?? NULL)) {
    $data['enabled'] = FALSE;
    $repaired[] = 'enabled';
  }

  foreach (['staff', 'customer_email_field', 'contact_line'] as $key) {
    if (!is_string($data['recipients'][$key] ?? NULL)) {
      $data['recipients'][$key] = '';
      $repaired[] = 'recipients.' . $key;
    }
  }

  return $data;
}

/**
 * Enforces the dispatch values the product treats as invariants.
 *
 * Each repair below fires only when the stored value is absent or cannot be
 * honoured. A stricter local value is left in place.
 */
function _custom_webform_handlers_enforce_dispatch_invariants(array $data, array $shipped, array &$repaired): array {
  // Express Courier is the only self-bookable service. "courier" is the
  // canonical machine value behind that public label, and a mapping that names
  // anything else - the 'm1' left behind by testing, for instance - maps to no
  // service this module can plan, price, or refuse for a stated reason.
  $allowed = ['courier'];
  $configured = $data['self_bookable']['service_types'] ?? NULL;
  $mapping_is_valid = is_array($configured) && $configured !== [] && array_is_list($configured);
  if ($mapping_is_valid) {
    foreach ($configured as $type) {
      if (!is_string($type) || !in_array($type, $allowed, TRUE)) {
        $mapping_is_valid = FALSE;
        break;
      }
    }
  }
  if (!$mapping_is_valid) {
    $data['self_bookable']['service_types'] = $allowed;
    $repaired[] = 'self_bookable.service_types';
  }

  // The weight ceiling and the one-driver rule are checked against answers to
  // these questions, so an unasked question cannot count as a passed check. The
  // contents affirmation is in the same class: the quote refuses to price a
  // package whose contents are not affirmed, and an offer that ignored the same
  // silence would give an arrival time for a job the estimate sent to staff.
  foreach (['require_declared_weight', 'require_single_driver_handling', 'store_pickup_requires_paid_and_ready', 'require_contents_attestation'] as $flag) {
    if (($data['self_bookable'][$flag] ?? NULL) !== TRUE) {
      $data['self_bookable'][$flag] = TRUE;
      $repaired[] = 'self_bookable.' . $flag;
    }
  }

  // The elements those questions are read from. A required check with nothing
  // mapped to read refuses every request, which is safe but is not the product:
  // the shipped mapping names this module's own element keys and invents no
  // operational data. An operator's own non-empty mapping is left alone.
  foreach (['contents_attestation', 'contents_attestation_legacy'] as $key) {
    $current = $data['request_fields'][$key] ?? NULL;
    if (!is_string($current) || trim($current) === '') {
      $shipped_value = $shipped['request_fields'][$key] ?? NULL;
      if (is_string($shipped_value) && trim($shipped_value) !== '') {
        $data['request_fields'][$key] = $shipped_value;
        $repaired[] = 'request_fields.' . $key;
      }
    }
  }

  // An empty handling-marker mapping reads no markers, so the manual_review list
  // below has nothing to match and a stated bad answer passes the gate. Repaired
  // on the same terms as that list: only when the active value is empty.
  $flags = $data['request_fields']['handling_flags'] ?? NULL;
  if ((!is_array($flags) || $flags === []) && !empty($shipped['request_fields']['handling_flags'])) {
    $data['request_fields']['handling_flags'] = $shipped['request_fields']['handling_flags'];
    $repaired[] = 'request_fields.handling_flags';
  }

  // 30 lb is the product ceiling for self-booking. A lower local ceiling is
  // stricter and survives; a higher one would let heavier work past the gate.
  $limit = $data['self_bookable']['max_package_lbs'] ?? NULL;
  if (!is_int($limit) || $limit <= 0 || $limit > 30) {
    $data['self_bookable']['max_package_lbs'] = 30;
    $repaired[] = 'self_bookable.max_package_lbs';
  }

  // One Resource serves one Dispatch Window at a time.
  if (($data['resource']['capacity'] ?? NULL) !== 1) {
    $data['resource']['capacity'] = 1;
    $repaired[] = 'resource.capacity';
  }

  // Scheduling and display stay in New York local time; stored instants stay
  // UTC. An unreadable zone is replaced rather than guessed around, because
  // substituting UTC here would silently move every working day.
  $zone = $data['resource']['timezone'] ?? NULL;
  $readable = FALSE;
  if (is_string($zone) && $zone !== '') {
    try {
      new \DateTimeZone($zone);
      $readable = TRUE;
    }
    catch (\Exception) {
      $readable = FALSE;
    }
  }
  if (!$readable) {
    $data['resource']['timezone'] = 'America/New_York';
    $repaired[] = 'resource.timezone';
  }

  // A Hold that lasts no time can neither be claimed nor renewed, and
  // DispatchHoldWindow deliberately substitutes no number of its own.
  $hold = $data['holds']['hold_seconds'] ?? NULL;
  if (!is_int($hold) || $hold <= 0) {
    $data['holds']['hold_seconds'] = 900;
    $repaired[] = 'holds.hold_seconds';
  }

  // An empty Manual Review list routes ineligible work nowhere. The shipped
  // lists name this module's own vocabulary and invent no operational data.
  foreach (['service_types', 'vehicle_helper_needs', 'handling_flags'] as $key) {
    $current = $data['manual_review'][$key] ?? NULL;
    if ((!is_array($current) || $current === []) && !empty($shipped['manual_review'][$key])) {
      $data['manual_review'][$key] = $shipped['manual_review'][$key];
      $repaired[] = 'manual_review.' . $key;
    }
  }

  return $data;
}

/**
 * Builds the homepage Express Courier offer journey (Task 5, Steps 1-2).
 *
 * Rearranges the hg wizard into the journey's first three steps, turns the
 * service selector into an accessible radio-card group, and activates the
 * Dispatch offer seam - all by editing the stored element tree and handler
 * configuration rather than at render time, because Webform builds only the
 * current wizard page per request and so alterForm() cannot move an element
 * from one step to another.
 *
 * Every existing element key is retained so stored submissions stay readable;
 * nodes are moved, never renamed. The step a hidden storage element sits on
 * does not change what is collected - Webform accumulates every page's data -
 * so only the visible facts are repositioned to match the journey:
 *  - Step 1: service_type, delivery_mode, address (From / To).
 *  - Step 2: package and per-service facts, non-courier scheduling, the quote
 *    preview, and the hidden dispatch_slot the offer widget mounts beside.
 *  - Step 3: contact details, the pickup/delivery handoff group and photo
 *    moved out of Step 1 (none may alter an offer), consent, hidden quote
 *    fields, and the hidden dispatch_hold_marker.
 *
 * The handoff elements keep their own service_type / delivery_mode #states: the
 * triggers live on Step 1 and Webform evaluates cross-page conditions on the
 * server against the accumulated submission, so they stay courier-gated after
 * the move. preferred_service_date / _time / date_flexibility lose their hard
 * required flag and become visible-and-required only when a non-courier service
 * is chosen, because Express Courier schedules through the Slot offer instead.
 *
 * Activating dispatch turns per-form reservations off (the two are mutually
 * exclusive), so the six non-courier services submit as quote-and-contact
 * requests that staff schedule by hand. Selecting a Slot still creates no Hold;
 * that stays the checkout seam's job. The workflow gate is deliberately not
 * flipped here - that is a separate, verification-gated step.
 *
 * Idempotent: the presence of the dispatch_slot element marks the restructure
 * as done, and the handler settings and block placement are re-asserted to the
 * same values on a re-run.
 */
function custom_webform_handlers_update_10016(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the homepage Express Courier journey was not built. Nothing was changed.');
  }

  $messages = [];
  $flattened = $webform->getElementsDecodedAndFlattened();
  $restructured = array_key_exists('dispatch_slot', $flattened);

  if ($restructured) {
    $messages[] = (string) t('The hg wizard already carries the dispatch_slot element, so its structure was left unchanged.');
  }
  else {
    $elements = $webform->getElementsDecoded();

    // The seven handoff elements are currently nested inside courier_details on
    // Step 1. Lift them out first so they can be dealt onto Step 3 as direct
    // children; each carries its own courier #states, so the gating moves too.
    $handoff_keys = [
      'pickup_contact_name',
      'pickup_contact_phone',
      'pickup_instructions',
      'delivery_contact_name',
      'delivery_contact_phone',
      'delivery_instructions',
      'handoff_preference',
    ];
    $extract = static function (array &$tree, string $target) use (&$extract) {
      foreach ($tree as $key => &$value) {
        if ((is_string($key) && str_starts_with($key, '#')) || !is_array($value)) {
          continue;
        }
        if ($key === $target) {
          $found = $value;
          unset($tree[$key]);
          return $found;
        }
        $found = $extract($value, $target);
        if ($found !== NULL) {
          return $found;
        }
      }
      return NULL;
    };
    $handoff = [];
    foreach ($handoff_keys as $handoff_key) {
      $node = $extract($elements, $handoff_key);
      if ($node !== NULL) {
        $handoff[$handoff_key] = $node;
      }
    }

    // Collect every page's direct children into one ordered pool, keep each
    // page's own #properties, and set aside any root-level element (the
    // reservation_hold_token sibling) untouched.
    $page_ids = ['page_1', 'page_2', 'page_3'];
    $children = [];
    $page_props = [];
    $root_extras = [];
    foreach ($elements as $top_key => $top_value) {
      if (in_array($top_key, $page_ids, TRUE) && is_array($top_value)) {
        $props = [];
        foreach ($top_value as $child_key => $child_value) {
          if (is_string($child_key) && str_starts_with($child_key, '#')) {
            $props[$child_key] = $child_value;
          }
          else {
            $children[$child_key] = $child_value;
          }
        }
        $page_props[$top_key] = $props;
      }
      else {
        $root_extras[$top_key] = $top_value;
      }
    }

    // Return the lifted handoff elements to the pool so Step 3 can claim them.
    foreach ($handoff as $handoff_key => $node) {
      $children[$handoff_key] = $node;
    }

    // The two hidden elements dispatch needs. The slot input is where the offer
    // widget writes the chosen arrival and beside which it mounts, so it belongs
    // on Step 2. The marker is the "an arrival was chosen" flag; it never
    // carries the token and stays hidden from submission views.
    $children['dispatch_slot'] = [
      '#type' => 'hidden',
      '#title' => (string) t('Selected pickup arrival'),
    ];
    $children['dispatch_hold_marker'] = [
      '#type' => 'hidden',
      '#title' => (string) t('Dispatch hold marker'),
      '#access_view_roles' => [],
    ];

    // service_type becomes an accessible radio-card group. The machine values,
    // the courier-first order, and server validation are unchanged; only the
    // widget and the now-meaningless empty option change.
    if (isset($children['service_type']) && is_array($children['service_type'])) {
      $service = &$children['service_type'];
      $service['#type'] = 'radios';
      if (isset($service['#options']) && is_array($service['#options'])) {
        unset($service['#options']['']);
        if (array_key_exists('courier', $service['#options'])) {
          $courier_label = $service['#options']['courier'];
          unset($service['#options']['courier']);
          $service['#options'] = ['courier' => $courier_label] + $service['#options'];
        }
      }
      // A select can rest on the empty option; a required radio group cannot.
      if (($service['#default_value'] ?? NULL) === '') {
        unset($service['#default_value']);
      }
      $classes = $service['#attributes']['class'] ?? [];
      if (!is_array($classes)) {
        $classes = [];
      }
      if (!in_array('custom-service-cards', $classes, TRUE)) {
        $classes[] = 'custom-service-cards';
      }
      $service['#attributes']['class'] = $classes;
      unset($service);
    }

    // Express Courier schedules through the Slot offer, so the fixed date/time
    // controls are required only for the other services. The trigger lives on
    // Step 1; Webform evaluates this condition server-side across pages.
    $non_courier = [':input[name="service_type"]' => ['!value' => 'courier']];
    foreach (['preferred_service_date', 'preferred_service_time', 'date_flexibility'] as $schedule_key) {
      if (!isset($children[$schedule_key]) || !is_array($children[$schedule_key])) {
        continue;
      }
      $control = &$children[$schedule_key];
      unset($control['#required']);
      $states = (isset($control['#states']) && is_array($control['#states'])) ? $control['#states'] : [];
      $states['visible'] = $non_courier;
      $states['required'] = $non_courier;
      $control['#states'] = $states;
      unset($control);
    }

    // Deal the pool onto the three steps. Anything not explicitly claimed stays
    // on Step 2, so no element can be dropped by omission. The quote preview and
    // the offer mount are forced last on Step 2, after every fact that can
    // change the quote.
    $page_1_layout = ['service_type', 'delivery_mode', 'address'];
    $page_3_layout = [
      'contact_information',
      'pickup_contact_name',
      'pickup_contact_phone',
      'pickup_instructions',
      'delivery_contact_name',
      'delivery_contact_phone',
      'delivery_instructions',
      'handoff_preference',
      'universal_item_file',
      'quote_disclaimer',
      'data_consent',
      'dispatch_hold_marker',
      'final_calculated_quote',
      'estimated_quote_currency',
      'estimated_quote_status',
      'estimated_quote_breakdown',
      'estimated_quote_rate_version',
      'disclaimer',
    ];
    $page_2_layout = array_values(array_diff(array_keys($children), $page_1_layout, $page_3_layout));
    $page_2_layout = array_values(array_filter($page_2_layout, static fn ($key) => !in_array($key, ['quote_preview', 'dispatch_slot'], TRUE)));
    if (array_key_exists('quote_preview', $children)) {
      $page_2_layout[] = 'quote_preview';
    }
    $page_2_layout[] = 'dispatch_slot';

    $titles = [
      'page_1' => (string) t('1. Route & Service'),
      'page_2' => (string) t('2. Package & Quote'),
      'page_3' => (string) t('3. Contact & Handoff'),
    ];
    $layouts = [
      'page_1' => $page_1_layout,
      'page_2' => $page_2_layout,
      'page_3' => $page_3_layout,
    ];

    $new = [];
    foreach ($layouts as $page_id => $layout) {
      $props = $page_props[$page_id] ?? ['#type' => 'webform_wizard_page'];
      $props['#title'] = $titles[$page_id];
      $new[$page_id] = $props;
      foreach ($layout as $key) {
        if (array_key_exists($key, $children)) {
          $new[$page_id][$key] = $children[$key];
        }
      }
    }
    // Preserve root-level siblings (reservation_hold_token) exactly as they were.
    foreach ($root_extras as $key => $value) {
      $new[$key] = $value;
    }

    $webform->setElements($new);
    $messages[] = (string) t('The hg wizard was rebuilt into Route & Service, Package & Quote, and Contact & Handoff steps; service_type is now an accessible radio-card group and the dispatch_slot and dispatch_hold_marker elements were added.');
  }

  // Activate the Dispatch offer seam on the hg handler. Setting the same values
  // on a re-run is a no-op. reservation_enabled is turned off because dispatch
  // and reservations are mutually exclusive per form.
  $target_handler = NULL;
  foreach ($webform->getHandlers() as $handler) {
    if ($handler->getPluginId() === 'address_distance_handler') {
      $target_handler = $handler;
      break;
    }
  }
  if ($target_handler !== NULL) {
    $config = $target_handler->getConfiguration();
    $settings = is_array($config['settings'] ?? NULL) ? $config['settings'] : [];
    $settings['reservation_enabled'] = FALSE;
    $settings['dispatch_enabled'] = TRUE;
    $settings['dispatch_slot_field'] = 'dispatch_slot';
    $settings['dispatch_hold_token_field'] = 'dispatch_hold_marker';
    $config['settings'] = $settings;
    $target_handler->setConfiguration($config);
    // Persists the handler configuration and the rebuilt elements in one save.
    $webform->updateWebformHandler($target_handler);
    $messages[] = (string) t('The hg route handler now runs the Dispatch offer seam (dispatch_enabled, reservations off, slot and marker fields wired).');
  }
  else {
    // No handler to activate, but any element rebuild above still must persist.
    $webform->save();
    $messages[] = (string) t('No address_distance_handler was found on hg, so dispatch activation was skipped; the wizard structure was still saved.');
  }

  // Place the hg webform on the homepage through a Webform block, created only
  // when absent so an operator's later edits to region, visibility, source
  // form, or title are never reverted by a re-run.
  $block_storage = \Drupal::entityTypeManager()->getStorage('block');
  $block_id = 'hg_express_courier_home';
  if ($block_storage->load($block_id) !== NULL) {
    $messages[] = (string) t('The homepage Express Courier block was already present and was left as configured.');
  }
  elseif (!\Drupal::service('plugin.manager.block')->hasDefinition('webform_block')) {
    $messages[] = (string) t('The Webform block plugin is unavailable, so the homepage block was not placed. Add the hg webform to the homepage manually.');
  }
  else {
    $default_theme = (string) \Drupal::config('system.theme')->get('default');
    if ($default_theme === '') {
      $default_theme = 'olivero';
    }
    $block_storage->create([
      'id' => $block_id,
      'theme' => $default_theme,
      'region' => 'content_above',
      'weight' => -20,
      'plugin' => 'webform_block',
      'settings' => [
        'id' => 'webform_block',
        'label' => 'Express Courier quote request',
        'label_display' => '0',
        'provider' => 'webform',
        'webform_id' => 'hg',
        'default_data' => '',
        'redirect' => FALSE,
        'lazy' => FALSE,
      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'context_mapping' => [],
          'pages' => '<front>',
        ],
      ],
    ])->save();
    $messages[] = (string) t('The hg webform was placed on the homepage (content_above region of the @theme theme, front page only).', ['@theme' => $default_theme]);
  }

  return implode(' ', $messages);
}

/**
 * Transfers the hg logistics form to the Dispatch booking workflow.
 *
 * update_10016 built the homepage journey and pointed the hg handler at dispatch,
 * but deliberately left this allowlist alone, because it is the one switch that
 * changes what the public form is allowed to do. It was held back until the
 * visible Slot journey had been exercised in a browser. That has now happened, so
 * the assignment is recorded here instead of surviving only as a local edit that
 * the next configuration import or fresh environment would lose.
 *
 * workflow.dispatch_webforms is the single list every part of the gate consults:
 * BookingWorkflowGate reads it, AddressDistanceHandler asks the gate before it
 * publishes any dispatch settings to the browser, and BookingWorkflowAccessCheck
 * asks the same question before serving a booking route. So naming hg here is
 * what simultaneously makes the Slot widget attach to the public form and makes
 * the retired fixed-slot routes refuse that same form - one list, so the two can
 * never disagree about which workflow owns hg.
 *
 * Only hg is transferred. Every other form keeps the workflow it already has,
 * which for all of them is the untouched default.
 *
 * Idempotent: the stored list is rebuilt with blanks and repeats dropped, hg is
 * appended only when it is not already named, and the save is skipped entirely
 * when the rebuilt list matches what is stored - so a re-run writes nothing and
 * can never add hg twice. Entries an operator added by hand are carried through
 * unchanged rather than replaced.
 */
function custom_webform_handlers_update_10017(): string {
  if (\Drupal\webform\Entity\Webform::load('hg') === NULL) {
    return (string) t('The hg webform was not found, so it was not transferred to the Dispatch booking workflow. Nothing was changed.');
  }

  $config = \Drupal::configFactory()->getEditable('custom_webform_handlers.dispatch');
  $stored = $config->get('workflow.dispatch_webforms');
  $stored = is_array($stored) ? $stored : [];

  $webforms = [];
  foreach ($stored as $webform_id) {
    $webform_id = trim((string) $webform_id);
    if ($webform_id !== '' && !in_array($webform_id, $webforms, TRUE)) {
      $webforms[] = $webform_id;
    }
  }
  if (!in_array('hg', $webforms, TRUE)) {
    $webforms[] = 'hg';
  }

  if ($webforms === array_values($stored)) {
    return (string) t('The hg webform is already assigned to the Dispatch booking workflow (@list), so the allowlist was left unchanged.', [
      '@list' => implode(', ', $webforms),
    ]);
  }

  $config->set('workflow.dispatch_webforms', $webforms)->save();

  return (string) t('Transferred the hg webform to the Dispatch booking workflow. Forms now owned by the Dispatch Planner: @list. The public hg form offers Dispatch Slots from here on, and the retired fixed-slot booking routes now refuse it.', [
    '@list' => implode(', ', $webforms),
  ]);
}

/**
 * Enables checkout and payment and installs the dispatch checkout flow.
 *
 * Steps 3-4 of the booking journey are Commerce checkout: contact details, an
 * authorise-first payment, and an atomic capacity confirmation. This update turns
 * that on for a site that already runs the Dispatch Planner. Every step is
 * create-if-absent, so an operator who has already enabled checkout, or who reruns
 * updates, is neither overwritten nor errored.
 *
 * The order is load-bearing. commerce_checkout and commerce_payment are enabled
 * first, because the checkout flow is a commerce_checkout config entity and the
 * payment pane subclasses a commerce_payment plugin; neither can be created until
 * those modules — and the entity types and config schema they provide — exist.
 * module_installer rebuilds the container synchronously, so the rest of this
 * function sees them. The dispatch order type is ensured next, because the contact
 * fields attach to its bundle. Then the flow and the two contact fields are created
 * from this module's own config/install, through the entity API, so Commerce
 * validates and computes their dependencies exactly as it would on a fresh install.
 * Finally the order type is bound to the flow.
 */
function custom_webform_handlers_update_10018(): string {
  $messages = [];

  // 1. Enable checkout and payment if they are not already on. module_installer
  // resolves their own dependencies (commerce_cart among them) and rebuilds the
  // container in this request, so the entity types and schema they provide are
  // available to every step below.
  $installer = \Drupal::service('module_installer');
  $handler = \Drupal::moduleHandler();
  $needed = [];
  foreach (['commerce_checkout', 'commerce_payment'] as $module) {
    if (!$handler->moduleExists($module)) {
      $needed[] = $module;
    }
  }
  if ($needed !== []) {
    $installer->install($needed);
    $messages[] = (string) t('Enabled @modules.', ['@modules' => implode(', ', $needed)]);
  }
  else {
    $messages[] = (string) t('Commerce checkout and payment were already enabled.');
  }

  // 2. Ensure the dispatch order type (and order-item type) exist: the contact
  // fields below attach to the dispatch bundle. Idempotent, and shared with the
  // earlier install path.
  $messages[] = _custom_webform_handlers_install_commerce_types();

  // 3. Create-if-absent the checkout flow and the two contact fields from this
  // module's config/install, mirroring _custom_webform_handlers_install_commerce_types().
  // Insertion order carries the prerequisites: the flow first, then each field
  // storage before the field instance that depends on it.
  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);
  $created = [];
  $present = [];

  $configs = [
    'commerce_checkout_flow' => [
      'commerce_checkout.commerce_checkout_flow.dispatch',
    ],
    'field_storage_config' => [
      'field.storage.commerce_order.field_dispatch_contact_name',
      'field.storage.commerce_order.field_dispatch_contact_phone',
    ],
    'field_config' => [
      'field.field.commerce_order.dispatch.field_dispatch_contact_name',
      'field.field.commerce_order.dispatch.field_dispatch_contact_phone',
    ],
  ];

  foreach ($configs as $entityTypeId => $names) {
    $storage = \Drupal::entityTypeManager()->getStorage($entityTypeId);
    foreach ($names as $name) {
      $shipped = $source->read($name);
      if (!is_array($shipped) || !isset($shipped['id'])) {
        throw new \Drupal\Core\Utility\UpdateException(sprintf('The default configuration %s.yml could not be read from %s.', $name, $directory));
      }

      if ($storage->load($shipped['id']) !== NULL) {
        $present[] = $name;
        continue;
      }

      $storage->create($shipped)->save();
      $created[] = $name;
    }
  }

  $messages[] = (string) t('Checkout configuration created: @created. Already present: @present.', [
    '@created' => $created ? implode(', ', $created) : 'none',
    '@present' => $present ? implode(', ', $present) : 'none',
  ]);

  // 4. Bind the dispatch order type to the dispatch checkout flow. Only ever fills
  // in an empty binding: a flow an operator set on purpose is reported and left
  // alone, never reverted, the same restraint the install helpers show elsewhere.
  $order_type = \Drupal::entityTypeManager()->getStorage('commerce_order_type')->load('dispatch');
  if ($order_type === NULL) {
    $messages[] = (string) t('The dispatch order type is missing, so it was not bound to the dispatch checkout flow.');
  }
  else {
    $current = (string) $order_type->getThirdPartySetting('commerce_checkout', 'checkout_flow');
    if ($current === 'dispatch') {
      $messages[] = (string) t('The dispatch order type already checks out through the dispatch flow.');
    }
    elseif ($current !== '') {
      $messages[] = (string) t('The dispatch order type checks out through the @flow flow, set outside this module, so it was left unchanged.', [
        '@flow' => $current,
      ]);
    }
    else {
      $order_type->setThirdPartySetting('commerce_checkout', 'checkout_flow', 'dispatch');
      $order_type->save();
      $messages[] = (string) t('The dispatch order type now checks out through the dispatch flow.');
    }
  }

  return implode(' ', $messages);
}

/**
 * Widens the Checkout Attempt state column to hold reconciliation_required.
 *
 * The settled money model added a fifth Checkout Attempt state,
 * reconciliation_required (CheckoutState::ReconciliationRequired), for a booking
 * that was confirmed but whose authorization could not be captured. Its stored
 * value is 23 characters, but the column was sized at 16 for the original four
 * states, so settling a confirmed-but-uncaptured attempt raised
 * SQLSTATE[22001] "Data too long for column 'state'" and left the attempt stuck
 * pending. Widen the column to 32 so the state the manager already writes can be
 * stored. Non-destructive: existing values are unchanged, and MariaDB preserves
 * the attempt_submission index across a length-only widening.
 */
function custom_webform_handlers_update_10019(): string {
  $table = 'custom_webform_handlers_checkout_attempt';
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists($table)) {
    return (string) t('The Checkout Attempt table is not present, so its state column was not widened.');
  }

  $schema->changeField($table, 'state', 'state', [
    'type' => 'varchar_ascii',
    'length' => 32,
    'not null' => TRUE,
    'description' => 'pending, paid, failed, cancelled, or reconciliation_required.',
  ]);

  return (string) t('Widened the Checkout Attempt state column to 32 characters so a confirmed-but-uncaptured attempt can settle to reconciliation_required.');
}

/**
 * Moves the dispatch checkout flow onto the plugin that gates order placement.
 *
 * The flow was configured with Commerce's multistep_default plugin, on the reading
 * that only pane placement was bespoke. It is not: CheckoutFlowBase::onStepChange()
 * places the order — dispatching CheckoutEvents::COMPLETION and applying the
 * 'place' transition, which is what emails the customer their receipt — inside the
 * same redirectToStep() call that authorises the card, before any pane can say
 * whether the Slot was confirmed. A refused Slot therefore left the money and the
 * capacity correct (authorization voided, Hold released, attempt failed) while the
 * customer was emailed "order confirmed" and, because getStepId() sends every
 * request for a placed order to the complete step, shown "Your pickup is booked".
 *
 * dispatch_flow is that same multistep flow with the capacity confirmation moved to
 * before the placement, so a refused booking places no order and sends no receipt.
 * It adds no step, pane, or setting, so the flow's stored configuration carries over
 * untouched and only the plugin id changes.
 *
 * Idempotent, and it will not overwrite a flow an operator has pointed at some other
 * plugin.
 */
function custom_webform_handlers_update_10020(): string {
  $config = \Drupal::configFactory()->getEditable('commerce_checkout.commerce_checkout_flow.dispatch');
  if ($config->isNew()) {
    return (string) t('The dispatch checkout flow is not present, so no flow plugin was changed.');
  }

  $current = (string) $config->get('plugin');
  if ($current === 'dispatch_flow') {
    return (string) t('The dispatch checkout flow already gates order placement on a confirmed Slot.');
  }

  if ($current !== 'multistep_default') {
    return (string) t('The dispatch checkout flow uses the @plugin plugin, set outside this module, so it was left unchanged. Point it at dispatch_flow to keep a refused booking from placing an order.', [
      '@plugin' => $current,
    ]);
  }

  $config->set('plugin', 'dispatch_flow')->save();

  return (string) t('The dispatch checkout flow now uses dispatch_flow, so a Slot that cannot be confirmed no longer places the order or sends a confirmation receipt.');
}

/**
 * Creates the Review Request table for the staff pricing lifecycle.
 *
 * The one authoritative record of a job a human has to price: its state, the
 * submission it came from, the order and Dispatch Reservation it reaches when it is
 * paid for, the authoritative quote staff prepared, the audit actor, and the hashed
 * tracking credential its customer holds.
 *
 * It is a table rather than fields on the submission because every invariant it
 * carries is a uniqueness invariant — one review per job, one request per code — and
 * the Field API cannot declare a unique index. And because a submission's element
 * values are visible wherever the submission is, while the credential must not be.
 *
 * Idempotent: an existing table is left exactly as it is, so a site that already ran
 * this can run it again safely. Non-destructive — it creates and does not alter.
 */
function custom_webform_handlers_update_10021(): string {
  $table = 'custom_webform_handlers_review_request';
  $schema = \Drupal::database()->schema();

  if ($schema->tableExists($table)) {
    return (string) t('The Review Request table is already present, so nothing was created.');
  }

  // Read from the module's own schema definition rather than repeated here, so the
  // installed table and a freshly installed one can never drift apart.
  $definition = custom_webform_handlers_schema()[$table] ?? NULL;
  if ($definition === NULL) {
    return (string) t('The Review Request table could not be created: this module declares no schema for it.');
  }

  $schema->createTable($table, $definition);

  return (string) t('Created the Review Request table, so a job a human has to price now has one authoritative record with a hashed tracking credential and no raw token.');
}

/**
 * Installs the three Dispatch roles, so item 8's split has somewhere to be used.
 *
 * The permissions themselves arrive with the module and are useless on their own: a
 * split that nobody is granted the halves of is a split that has not happened. These
 * three roles are the halves, and they are ordinary configuration — a site that wants a
 * fourth combination writes a fourth role and needs no code from anybody.
 *
 * Read from this module's own config/install rather than restated here, so an installed
 * site and a freshly installed one get the same three roles from the same three files.
 *
 * Idempotent, and deliberately not an overwrite. A role that already exists is left
 * exactly as it is: an operator may have added a permission to the Schedule Manager
 * that their depot genuinely needs, and an update hook that silently took it away again
 * would be a permission change nobody asked for and nobody was told about.
 */
function custom_webform_handlers_update_10022(): string {
  $ids = [
    'dispatch_schedule_manager',
    'dispatch_viewer',
    'dispatch_financial_viewer',
  ];

  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);

  $created = [];
  $kept = [];
  foreach ($ids as $id) {
    if (\Drupal\user\Entity\Role::load($id) !== NULL) {
      $kept[] = $id;

      continue;
    }

    $definition = $source->read('user.role.' . $id);
    if (!is_array($definition)) {
      continue;
    }

    \Drupal\user\Entity\Role::create($definition)->save();
    $created[] = $id;
  }

  return custom_webform_handlers_role_install_report($created, $kept);
}

/**
 * What update 10022 did, said in terms of what an operator now has to do.
 *
 * Separated because the interesting half of this update is not the writing but the
 * grant that has to follow it: a role nobody holds changes nothing, and the broad
 * permission it replaces keeps working until somebody takes it away.
 */
function custom_webform_handlers_role_install_report(array $created, array $kept): string {
  if ($created === []) {
    return (string) t('All three Dispatch roles were already present, so none was changed: @kept.', [
      '@kept' => implode(', ', $kept),
    ]);
  }

  if ($kept === []) {
    return (string) t('Created the three Dispatch roles: @created. No account holds any of them yet, and the broad grants they replace still work — assign the roles, then withdraw those.', [
      '@created' => implode(', ', $created),
    ]);
  }

  return (string) t('Created @created, and left @kept exactly as configured: a role a site has already tuned is not this module’s to overwrite.', [
    '@created' => implode(', ', $created),
    '@kept' => implode(', ', $kept),
  ]);
}

/**
 * Opens a Review Request for stalled work that predates the Review Request table.
 *
 * The migration the board's cutover needs, and the reason it is not optional. The
 * Manual Review queue used to be a scan: every dispatch Webform's newest completed
 * submissions, filtered on a saved quote status. It is now read from the Review
 * Requests themselves, which is specification item 6 — one queue, so the row an
 * operator works from and the row that records their decision are the same row. The
 * cost of that is exactly this: a job that stalled before the table existed has a
 * status and no request, and after the cutover a queue built from requests would
 * simply not show it. The customer would still be owed an answer and nobody would
 * see the question.
 *
 * So every completed submission whose configured quote status element records the
 * manual-review status gets a request. The work is found by that element and not by
 * the cutover interlock: whether dispatch or the older fixed-slot guard owns new
 * bookings on a Webform decides who enforces the next booking, and says nothing
 * about who owes an answer for a job the quote engine already gave up on.
 *
 * Every row goes through ReviewManagerInterface::open(), never through SQL. That is
 * the whole point of having one authority: the credential is hashed by the same code
 * that hashes a live one, the audit actor is written the same way, and the unique
 * index on the submission makes the hook idempotent for free — a second run finds
 * every request already open and creates nothing.
 *
 * One thing a backfill cannot do, and does not pretend to. The raw tracking code is
 * shown once, in the request that mints it, and these requests are minted by a batch
 * with nobody watching: the code returned here is discarded unread, so a backfilled
 * job has a working request and no customer link. That is honest rather than
 * unfortunate — a link cannot be handed retroactively to somebody who has left the
 * site — and staff keep every operation on the row, including the existing booking
 * path.
 *
 * Non-destructive. It reads Webform's own tables and writes only new Review
 * Requests; no submission, no quote, and no configuration is touched.
 */
function custom_webform_handlers_update_10023(): string {
  $requestFactory = \Drupal::service('custom_webform_handlers.dispatch_request_factory');
  $reviews = \Drupal::service('custom_webform_handlers.review_manager');
  $database = \Drupal::database();

  $ids = \Drupal::entityTypeManager()->getStorage('webform')
    ->getQuery()
    ->accessCheck(FALSE)
    ->execute();

  $opened = 0;
  $existing = 0;
  $refused = 0;
  $unconfigured = [];

  foreach ($ids as $id) {
    $webformId = (string) $id;
    if ($webformId === '') {
      continue;
    }

    $settings = $requestFactory->settingsFor($webformId);
    if ($settings === NULL) {
      continue;
    }

    $element = trim((string) ($settings['quote_status_field'] ?? ''));
    if ($element === '') {
      // A dispatch Webform that records no quote status has no stalled work to find,
      // because it never recorded that a job stalled. Reported rather than skipped
      // silently: it is the same misconfiguration the board itself warns about.
      $unconfigured[] = $webformId;

      continue;
    }

    // Completed submissions only, and the whole of them rather than a window: the
    // board's old scan looked at the newest hundred per Webform because it ran on
    // every page load, and a migration that inherited that limit would leave older
    // work invisible for good. A draft is excluded because the customer has not
    // finished asking yet, and a request opened against one would put a job on the
    // queue that nobody has actually submitted.
    $select = $database->select('webform_submission_data', 'd');
    $select->innerJoin('webform_submission', 's', 's.sid = d.sid');
    $sids = $select
      ->fields('d', ['sid'])
      ->condition('d.webform_id', $webformId)
      ->condition('d.name', $element)
      ->condition('d.value', 'manual_review')
      ->condition('s.completed', 0, '>')
      ->execute()
      ->fetchCol();

    foreach ($sids as $sid) {
      $issue = $reviews->open($webformId, (int) $sid);
      if ($issue === NULL) {
        // The manager refused and logged why. Counted so the report cannot read as a
        // clean run when part of it did not happen.
        $refused++;

        continue;
      }

      $issue->isNew() ? $opened++ : $existing++;
    }
  }

  return custom_webform_handlers_review_backfill_report($opened, $existing, $refused, $unconfigured);
}

/**
 * What update 10023 found, in the terms an operator has to act on.
 *
 * Separated for the reason 10022's report is: the number that matters is not how many
 * rows were written but whether anything was left behind. A refusal is named plainly,
 * because a stalled job with no request is a customer nobody can answer.
 */
function custom_webform_handlers_review_backfill_report(int $opened, int $existing, int $refused, array $unconfigured): string {
  $parts = [];

  $parts[] = $opened === 0
    ? (string) t('No stalled quote needed a Review Request opening for it.')
    : (string) t('Opened @opened Review Request(s) for work that stalled before the table existed, so it stays on the board now the queue is read from the requests themselves.', ['@opened' => $opened]);

  if ($existing > 0) {
    $parts[] = (string) t('@existing already had one and were left exactly as they are.', ['@existing' => $existing]);
  }

  if ($refused > 0) {
    $parts[] = (string) t('@refused could not be opened and are named in the log — those jobs are not on the queue and nobody can answer them until this is looked at.', ['@refused' => $refused]);
  }

  if ($unconfigured !== []) {
    $parts[] = (string) t('These dispatch forms record no quote status, so no stalled work could be found on them: @forms.', ['@forms' => implode(', ', $unconfigured)]);
  }

  return implode(' ', $parts);
}

/**
 * Installs the notification claim table and the maintenance queue.
 *
 * The infrastructure a durable notification path needs, and nothing else. No
 * Reservation is read, no Checkout Attempt is touched, no payment is examined, no
 * Review Request changes, and no existing configuration is rewritten — so nothing this
 * hook does can alter what Tasks 5, 6 or 7 established.
 *
 * Both steps are conditional on absence, so running this twice is a no-op and running
 * it on a site that was freshly installed from this release (where hook_schema() and
 * config/optional already produced both) reports that there was nothing to do.
 *
 * The claim table is created from custom_webform_handlers_schema() rather than from a
 * definition repeated here, so an updated site and a freshly installed one cannot drift
 * apart. The queue is created from the shipped config/optional file for the same
 * reason: the argued lease and processing budgets live in one place.
 */
function custom_webform_handlers_update_10024(): string {
  $messages = [];

  $table = 'custom_webform_handlers_dispatch_notify_claim';
  $schema = \Drupal::database()->schema();

  if ($schema->tableExists($table)) {
    $messages[] = (string) t('The notification claim table is already present, so it was left alone.');
  }
  else {
    $definition = custom_webform_handlers_schema()[$table] ?? NULL;

    if ($definition === NULL) {
      $messages[] = (string) t('The notification claim table could not be created: this module declares no schema for it. Queued notifications will refuse to send until this is resolved, which is the safe direction.');
    }
    else {
      $schema->createTable($table, $definition);
      $messages[] = (string) t('Created the notification claim table, so a replayed notification job now sends nothing instead of a second copy.');
    }
  }

  $messages[] = custom_webform_handlers_install_maintenance_queue();

  return implode(' ', $messages);
}

/**
 * Creates the maintenance queue from its shipped definition, if it is absent.
 *
 * Separated from the update hook because the interesting part is what it refuses to do.
 * A queue that already exists is never rewritten: an operator may have tuned the lease
 * or the processing budget on a live site to fit their cron, and an update that reset
 * that would be an update that changed behaviour nobody asked it to change.
 *
 * The definition is read from the module's own config/optional directory rather than
 * built here, so the comments arguing for those numbers stay next to the numbers.
 */
function custom_webform_handlers_install_maintenance_queue(): string {
  $id = 'custom_webform_handlers_maintenance';

  if (!\Drupal::moduleHandler()->moduleExists('advancedqueue')) {
    // Not an error. The queue is optional configuration precisely because this module
    // does not require Advanced Queue to install, and enabling it later applies the
    // shipped file without any help from here.
    return (string) t('Advanced Queue is not enabled, so the maintenance queue was not created. Enabling it installs the queue automatically.');
  }

  $storage = \Drupal::entityTypeManager()->getStorage('advancedqueue_queue');

  if ($storage->load($id) !== NULL) {
    return (string) t('The dispatch maintenance queue already exists and was left exactly as it is, including any locally tuned lease or processing time.');
  }

  $name = 'advancedqueue.advancedqueue_queue.' . $id;
  $source = new InstallStorage(InstallStorage::CONFIG_OPTIONAL_DIRECTORY);
  $data = $source->read($name);

  if (!is_array($data) || $data === []) {
    return (string) t('The dispatch maintenance queue definition could not be read from this module, so no queue was created. Route warming and popularity jobs have nowhere to run until it is.');
  }

  $storage->create($data)->save();

  return (string) t('Created the dispatch maintenance queue, so precomputation and nightly aggregation cannot consume the notification queue’s cron budget.');
}

/**
 * Installs the Service Type popularity ranking settings.
 *
 * A new site gets this file from config/install; a site that is already installed gets
 * it from here, because installed configuration is not re-read on update. Without it
 * the ranking layer still works — every reader falls back to a documented constant when
 * a value is missing — but the settings would be invisible, and an operator who wanted
 * to switch the feature off or widen its window would have nothing to edit. Making the
 * knobs visible is the whole point of running this.
 *
 * Idempotent, and specifically not a reset. A site that already has the object keeps
 * every value in it: an operator may have turned the feature off or lengthened the
 * window deliberately, and an update that overwrote that would be an update that
 * changed behaviour nobody asked it to change. Keys that were never present are added
 * with their shipped defaults, so a partially written object is completed rather than
 * replaced.
 *
 * Alters nothing from Task 5, 6 or 7. It writes one new config object and reads none of
 * the dispatch, checkout, payment or review settings.
 */
function custom_webform_handlers_update_10025(): string {
  $name = 'custom_webform_handlers.ranking';

  // The shipped defaults, read from the module's own install file rather than repeated
  // here, so the comments arguing for these numbers stay next to the numbers.
  $source = new InstallStorage();
  $shipped = $source->read($name);

  if (!is_array($shipped) || $shipped === []) {
    return (string) t('The ranking settings could not be read from this module, so nothing was written. The service cards keep their configured order, which is what they would have done anyway.');
  }

  $config = \Drupal::configFactory()->getEditable($name);
  $existing = $config->get();

  if ($existing !== NULL && $existing !== []) {
    $added = array_diff_key($shipped, $existing);

    if ($added === []) {
      return (string) t('The ranking settings are already present and were left exactly as they are, including any locally chosen window or threshold.');
    }

    foreach ($added as $key => $value) {
      $config->set($key, $value);
    }
    $config->save();

    return (string) t('Completed the existing ranking settings with @count shipped default(s) that were missing, and changed nothing that was already set.', [
      '@count' => count($added),
    ]);
  }

  $config->setData($shipped)->save();

  return (string) t('Installed the ranking settings, so measured popularity may reorder the service cards after @samples bookings in @days days. Express Courier stays first regardless; it is pinned in code, not here.', [
    '@samples' => (int) ($shipped['minimum_samples'] ?? 25),
    '@days' => (int) ($shipped['window_days'] ?? 90),
  ]);
}

/**
 * Installs the two ECA dispatch reaction models, if they are absent.
 *
 * A new site gets these from config/optional the moment both this module and ECA are
 * enabled; a site that already has both installed gets them from here, because optional
 * configuration is not re-read on update. They are the reaction layer, not the work: they
 * turn a committed Reservation into a queued route-warm and a Review Request transition
 * into a queued popularity recount. Without them the jobs still run — cron drives the
 * nightly recount and the checkout and review code emits the events either way — so what
 * is missing on a site that never gets them is only the opportunistic enqueue, never a
 * booking, a payment, or a decision. That is a smaller site, not a broken one.
 *
 * Gated on ECA being enabled, and specifically not a reset. A model that already exists
 * is left exactly as it is: an operator may have re-authored a reaction, and an update
 * that overwrote that would be an update that changed behaviour nobody asked it to
 * change. Each model is read from this module's own config/optional directory rather than
 * built here, so the wiring stays next to the plugin ids it names.
 *
 * Alters nothing from Task 5, 6 or 7. It writes only ECA configuration and reads none of
 * the dispatch, checkout, payment or review settings; the events these models react to
 * are dispatched only after their authoritative transaction has already committed, so a
 * reaction can read what happened and never change whether it happened.
 */
function custom_webform_handlers_update_10026(): string {
  if (!\Drupal::moduleHandler()->moduleExists('eca')) {
    // Not an error. The models are optional configuration precisely because this module
    // does not require ECA to install, and enabling ECA later applies the shipped files
    // without any help from here.
    return (string) t('ECA is not enabled, so the dispatch reaction models were not created. Enabling it installs them automatically.');
  }

  $storage = \Drupal::entityTypeManager()->getStorage('eca');
  $source = new InstallStorage(InstallStorage::CONFIG_OPTIONAL_DIRECTORY);

  // Both shipped models, by their config-entity id. The config name each is read from is
  // eca.eca.<id>, the entity type's own prefix.
  $ids = [
    'custom_webform_handlers_route_warm',
    'custom_webform_handlers_popularity',
  ];

  $created = [];
  $kept = [];
  $missing = [];

  foreach ($ids as $id) {
    if ($storage->load($id) !== NULL) {
      $kept[] = $id;
      continue;
    }

    $data = $source->read('eca.eca.' . $id);

    if (!is_array($data) || $data === []) {
      $missing[] = $id;
      continue;
    }

    $storage->create($data)->save();
    $created[] = $id;
  }

  $messages = [];

  if ($created !== []) {
    $messages[] = (string) t('Installed @count dispatch reaction model(s), so a confirmed Reservation warms its route and a Review Request transition refreshes the popularity snapshot without waiting for the next cron run.', [
      '@count' => count($created),
    ]);
  }

  if ($kept !== []) {
    $messages[] = (string) t('Left @count reaction model(s) exactly as they are, including any locally re-authored wiring.', [
      '@count' => count($kept),
    ]);
  }

  if ($missing !== []) {
    $messages[] = (string) t('Could not read @count reaction model(s) from this module, so they were not created; the jobs still run from cron and from the code that emits the events.', [
      '@count' => count($missing),
    ]);
  }

  return implode(' ', $messages);
}

/**
 * Simplifies and lays out the hg Express Courier journey.
 *
 * Courier now asks for a service and mode, two addresses, one weight in pounds,
 * one contents attestation, a pickup arrival, and clean contact details. No
 * element key is removed: the two retired courier radios only lose create
 * access, the move-only fieldsets only gain a non-courier visibility rule, and
 * nothing is deleted, so stored submissions still read exactly as before and the
 * other services keep every question they ask today.
 *
 * Idempotent: the presence of the courier_prohibited_ack element marks the work
 * as done. Operating hours are deliberately not touched here. They stay an
 * explicit operational action so a live operator's approved schedule cannot be
 * overwritten by a module update.
 */
function custom_webform_handlers_update_10027(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the Express Courier layout was not changed.');
  }

  $flattened = $webform->getElementsDecodedAndFlattened();
  if (array_key_exists('courier_prohibited_ack', $flattened)) {
    return (string) t('The hg webform already carries the simplified Express Courier layout, so its elements were left unchanged.');
  }

  $elements = $webform->getElementsDecoded();
  $page_ids = ['page_1', 'page_2', 'page_3'];
  foreach ($page_ids as $page_id) {
    if (!isset($elements[$page_id]) || !is_array($elements[$page_id])) {
      return (string) t('The hg webform does not have the three wizard pages this update expects, so its elements were left unchanged for manual review.');
    }
  }

  // Pull one element out of wherever it currently sits so it can be re-parented
  // with all of its own properties and #states intact, rather than rebuilt.
  $extract = static function (array &$tree, string $target) use (&$extract) {
    foreach ($tree as $key => &$value) {
      if ((is_string($key) && str_starts_with($key, '#')) || !is_array($value)) {
        continue;
      }
      if ($key === $target) {
        $found = $value;
        unset($tree[$key]);
        return $found;
      }
      $found = $extract($value, $target);
      if ($found !== NULL) {
        return $found;
      }
    }
    return NULL;
  };

  // Merge one selector into an existing #states rule without disturbing the
  // conditions already there. Webform reads both an associative selector map and
  // a list joined by an explicit 'and', and one map cannot hold two conditions
  // for the same input, so a colliding selector converts the rule to the list.
  $add_condition = static function (array $states, string $rule, array $condition): array {
    if (!isset($states[$rule]) || !is_array($states[$rule])) {
      $states[$rule] = [];
    }
    foreach ($condition as $selector => $test) {
      $existing = $states[$rule];
      if (!array_is_list($existing)) {
        if (!array_key_exists($selector, $existing)) {
          $states[$rule][$selector] = $test;
          continue;
        }
        $converted = [];
        foreach ($existing as $existing_selector => $existing_test) {
          if ($converted !== []) {
            $converted[] = 'and';
          }
          $converted[] = [$existing_selector => $existing_test];
        }
        $existing = $converted;
      }
      if (!in_array([$selector => $test], $existing, TRUE)) {
        if ($existing !== []) {
          $existing[] = 'and';
        }
        $existing[] = [$selector => $test];
      }
      $states[$rule] = $existing;
    }
    return $states;
  };

  // Re-order one container so the named leads come first and everything else
  // keeps its existing relative order behind them.
  $deal = static function (array $container, array $lead): array {
    $ordered = [];
    foreach ($container as $key => $value) {
      if (is_string($key) && str_starts_with($key, '#')) {
        $ordered[$key] = $value;
      }
    }
    foreach ($lead as $key) {
      if (array_key_exists($key, $container) && !str_starts_with($key, '#')) {
        $ordered[$key] = $container[$key];
      }
    }
    $rest = [];
    foreach ($container as $key => $value) {
      if (!array_key_exists($key, $ordered)) {
        $rest[$key] = $value;
      }
    }
    return $ordered + $rest;
  };

  // One responsive row. Webform's own flexbox CSS only splits into columns from
  // 768px up, so a row stacks on a phone with no extra rules. The row is only
  // emitted when every member was actually found, so a missing element degrades
  // to the untouched layout instead of a half-built row.
  $flex_row = static function (array $members, string $class): ?array {
    foreach ($members as $member) {
      if (!is_array($member)) {
        return NULL;
      }
    }
    $row = [
      '#type' => 'webform_flexbox',
      '#attributes' => ['class' => ['custom-courier-row', $class]],
    ];
    foreach ($members as $key => $member) {
      $member['#flex'] = 1;
      $row[$key] = $member;
    }
    return $row;
  };

  // Lift the elements that are about to be re-parented into rows. Each one is
  // taken from its current place in the tree, so nothing is duplicated.
  $lifted = [];
  foreach ([
    'origin_address',
    'destination_address',
    'total_weight_lbs',
    'single_driver_handling',
    'full_name',
    'phone_number',
    'email',
    'pickup_contact_name',
    'pickup_contact_phone',
    'delivery_contact_name',
    'delivery_contact_phone',
    'quote_disclaimer',
  ] as $lift_key) {
    $lifted[$lift_key] = $extract($elements, $lift_key);
  }

  // Pool every direct child of the three wizard pages, keep each page's own
  // properties, and keep any root-level sibling (such as the hold token) aside.
  $children = [];
  $page_props = [];
  $root_extras = [];
  foreach ($elements as $key => $value) {
    if (in_array($key, $page_ids, TRUE)) {
      foreach ($value as $child_key => $child) {
        if (is_string($child_key) && str_starts_with($child_key, '#')) {
          $page_props[$key][$child_key] = $child;
          continue;
        }
        $children[$child_key] = $child;
      }
      continue;
    }
    $root_extras[$key] = $value;
  }

  // Step 1, first row: pickup beside dropoff. The address fieldset is shared by
  // every service, so this is layout only and changes no validation.
  $address_row = $flex_row([
    'origin_address' => $lifted['origin_address'],
    'destination_address' => $lifted['destination_address'],
  ], 'custom-courier-row--address');
  if ($address_row !== NULL && isset($children['address'])) {
    $children['address']['address_row'] = $address_row;
    $children['address'] = $deal($children['address'], ['address_row']);
    unset($lifted['origin_address'], $lifted['destination_address']);
  }

  // One weight field, in pounds, as the only Courier package input.
  if (is_array($lifted['total_weight_lbs'])) {
    $lifted['total_weight_lbs']['#title'] = (string) t('Weight (lb)');
    $lifted['total_weight_lbs']['#description'] = (string) t('Total weight of everything together, in pounds.');
  }

  // The unit selector stops being a question and becomes a pounds-only hidden
  // input. It has to stay a real input: the pickup-arrival endpoint reads raw
  // browser values, and an absent unit there starves the request into manual
  // review. preSave re-forces pounds on the stored record regardless.
  if (isset($children['courier_details']['total_weight_unit'])) {
    $children['courier_details']['total_weight_unit'] = [
      '#type' => 'hidden',
      '#title' => (string) t('Weight unit'),
      '#default_value' => 'lb',
    ];
  }

  // The compact attestation replaces the three-option restricted-contents radio.
  // Unchecked, absent, or crafted input is mapped server-side to a manual-review
  // value in preSave; it is never read as consent.
  $courier_handling = [
    '#type' => 'container',
    '#attributes' => ['class' => ['custom-courier-handling']],
    'courier_prohibited_ack' => [
      '#type' => 'checkbox',
      '#title' => (string) t('I confirm this package contains no prohibited, hazardous, illegal, perishable, live, cash, or weapon items.'),
      '#description' => (string) t('Required to book online. Anything on that list is reviewed by staff instead.'),
      '#attributes' => ['class' => ['custom-courier-attestation']],
      '#states' => [
        'visible' => [':input[name="service_type"]' => ['value' => 'courier']],
        'required' => [':input[name="service_type"]' => ['value' => 'courier']],
      ],
    ],
  ];
  if (is_array($lifted['single_driver_handling'])) {
    $courier_handling['single_driver_handling'] = $lifted['single_driver_handling'];
  }

  // Step 1, second row: weight beside the two confirmations it is judged with.
  $package_row = $flex_row([
    'total_weight_lbs' => $lifted['total_weight_lbs'],
    'courier_handling' => $courier_handling,
  ], 'custom-courier-row--package');
  if ($package_row !== NULL && isset($children['courier_details'])) {
    $children['courier_details']['courier_package_row'] = $package_row;
    $children['courier_details'] = $deal($children['courier_details'], [
      'package_description',
      'courier_package_row',
    ]);
    unset($lifted['total_weight_lbs'], $lifted['single_driver_handling']);
  }

  // The two Courier questions that are now settled server-side stop being asked
  // on the create form, and only there. Emptying #access_create_roles makes
  // #access FALSE on that form, so the element is not rendered, carries no
  // #states validation, and falls back to its own #default_value.
  // #access_view_roles is untouched, so every historic submission still renders
  // its stored value with these same option labels.
  $retired_keys = [];
  foreach (['courier_urgency', 'prohibited_items_ack'] as $retired) {
    if (!isset($children['courier_details'][$retired])) {
      continue;
    }
    $children['courier_details'][$retired]['#access_create_roles'] = [];
    unset(
      $children['courier_details'][$retired]['#states'],
      $children['courier_details'][$retired]['#required']
    );
    $retired_keys[] = $retired;
  }

  // The move-only package and add-on blocks stop rendering for Courier and are
  // untouched for every other service.
  $non_courier = [':input[name="service_type"]' => ['!value' => 'courier']];
  $hidden_for_courier = [];
  foreach ([
    'shipment_measurements',
    'additional_services_fieldset',
    'virtual_walkthrough_option',
    'insurance_options_fieldset',
    'insurance_interest',
    'moving_tips',
  ] as $move_only) {
    if (!isset($children[$move_only]) || !is_array($children[$move_only])) {
      continue;
    }
    $states = (isset($children[$move_only]['#states']) && is_array($children[$move_only]['#states']))
      ? $children[$move_only]['#states']
      : [];
    $children[$move_only]['#states'] = $add_condition($states, 'visible', $non_courier);
    $hidden_for_courier[] = $move_only;
  }

  // The dimension questions were only ever required for Courier, and Courier no
  // longer renders them, so that one condition comes off. Every other service
  // keeps them exactly as optional as they are today.
  foreach (['item_quantity', 'item_length', 'item_width', 'item_height'] as $dimension) {
    if (isset($children['shipment_measurements'][$dimension]['#states']['required'])) {
      unset($children['shipment_measurements'][$dimension]['#states']['required']);
    }
  }

  // Send-only: one checkbox removes the duplicate contact entry. It is checked by
  // default, and preSave copies the sender name and phone into the pickup contact
  // fields, so the browser is never the authority for who we call at pickup.
  $children['pickup_same_as_sender'] = [
    '#type' => 'checkbox',
    '#title' => (string) t('Pickup contact is the same as sender'),
    '#description' => (string) t('Leave this checked if we should call you at pickup. Uncheck it to name someone else.'),
    '#default_value' => TRUE,
    '#attributes' => ['class' => ['custom-courier-same-as-sender']],
    '#states' => [
      'visible' => [
        ':input[name="service_type"]' => ['value' => 'courier'],
        ':input[name="delivery_mode"]' => ['value' => 'courier_send'],
      ],
    ],
  ];

  // The pickup contact pair is neither shown nor required while that checkbox is
  // checked. #states_clear is switched off so unchecking it brings back whatever
  // was already typed instead of an empty pair.
  $unchecked = [':input[name="pickup_same_as_sender"]' => ['unchecked' => TRUE]];
  foreach (['pickup_contact_name', 'pickup_contact_phone'] as $pickup_key) {
    if (!is_array($lifted[$pickup_key])) {
      continue;
    }
    $states = (isset($lifted[$pickup_key]['#states']) && is_array($lifted[$pickup_key]['#states']))
      ? $lifted[$pickup_key]['#states']
      : [];
    foreach (['visible', 'required'] as $rule) {
      if (isset($states[$rule])) {
        $states = $add_condition($states, $rule, $unchecked);
      }
    }
    $lifted[$pickup_key]['#states'] = $states;
    $lifted[$pickup_key]['#states_clear'] = FALSE;
  }

  $courier_visible = ['visible' => [':input[name="service_type"]' => ['value' => 'courier']]];
  $pickup_row = $flex_row([
    'pickup_contact_name' => $lifted['pickup_contact_name'],
    'pickup_contact_phone' => $lifted['pickup_contact_phone'],
  ], 'custom-courier-row--pickup');
  if ($pickup_row !== NULL) {
    $pickup_row['#states'] = $courier_visible;
    $pickup_row['#states_clear'] = FALSE;
    $children['pickup_contact_row'] = $pickup_row;
    unset($lifted['pickup_contact_name'], $lifted['pickup_contact_phone']);
  }

  $delivery_row = $flex_row([
    'delivery_contact_name' => $lifted['delivery_contact_name'],
    'delivery_contact_phone' => $lifted['delivery_contact_phone'],
  ], 'custom-courier-row--delivery');
  if ($delivery_row !== NULL) {
    $delivery_row['#states'] = $courier_visible;
    $children['delivery_contact_row'] = $delivery_row;
    unset($lifted['delivery_contact_name'], $lifted['delivery_contact_phone']);
  }

  // Step 3 opens with name, phone, and email in one row, for every service.
  $contact_row = $flex_row([
    'full_name' => $lifted['full_name'],
    'phone_number' => $lifted['phone_number'],
    'email' => $lifted['email'],
  ], 'custom-courier-row--contact');
  if ($contact_row !== NULL && isset($children['contact_information'])) {
    $children['contact_information']['contact_row'] = $contact_row;
    $children['contact_information'] = $deal($children['contact_information'], ['contact_row']);
    unset($lifted['full_name'], $lifted['phone_number'], $lifted['email']);
  }

  // The quote notice becomes a native collapsed details element instead of a
  // heading and three paragraphs sitting open in the middle of the last step. The
  // summary carries the heading text, so the now-duplicated <h3> comes out of the
  // markup; the wording itself is unchanged, and there is no modal and no new
  // page. The short non-binding line stays visible below it.
  if (is_array($lifted['quote_disclaimer'])) {
    $markup = (string) ($lifted['quote_disclaimer']['#markup'] ?? '');
    $stripped = preg_replace('~^\s*<h3\b[^>]*>.*?</h3>\s*~is', '', $markup, 1);
    if (is_string($stripped) && trim($stripped) !== '') {
      $lifted['quote_disclaimer']['#markup'] = $stripped;
    }
    $children['quote_information'] = [
      '#type' => 'details',
      '#title' => (string) t('Important information regarding your quote'),
      '#open' => FALSE,
      '#attributes' => ['class' => ['custom-courier-quote-info']],
      'quote_disclaimer' => $lifted['quote_disclaimer'],
    ];
    unset($lifted['quote_disclaimer']);
  }

  // Anything lifted that could not be re-parented goes straight back into the
  // pool, so a tree shape this update did not expect loses no element.
  foreach ($lifted as $leftover_key => $leftover) {
    if (is_array($leftover) && !array_key_exists($leftover_key, $children)) {
      $children[$leftover_key] = $leftover;
    }
  }

  // Deal the pool back onto the three pages. Step 1 carries the route, the mode,
  // and the Courier package block; Step 3 is contact and handoff; everything not
  // named here keeps its current place and order on Step 2, where the pickup
  // arrival and the estimate are forced last, after every fact that changes them.
  $page_1_layout = ['service_type', 'delivery_mode', 'address', 'address_row', 'courier_details'];
  $page_3_layout = [
    'contact_information',
    'contact_row',
    'pickup_same_as_sender',
    'pickup_contact_row',
    'pickup_instructions',
    'delivery_contact_row',
    'delivery_instructions',
    'handoff_preference',
    'universal_item_file',
    'quote_information',
    'disclaimer',
    'data_consent',
    'dispatch_hold_marker',
    'final_calculated_quote',
    'estimated_quote_currency',
    'estimated_quote_status',
    'estimated_quote_breakdown',
    'estimated_quote_rate_version',
  ];
  $page_2_layout = array_values(array_diff(
    array_keys($children),
    $page_1_layout,
    $page_3_layout,
    ['dispatch_slot', 'quote_preview']
  ));
  foreach (['dispatch_slot', 'quote_preview'] as $trailing) {
    if (array_key_exists($trailing, $children)) {
      $page_2_layout[] = $trailing;
    }
  }

  $new = [];
  foreach (['page_1' => $page_1_layout, 'page_2' => $page_2_layout, 'page_3' => $page_3_layout] as $page_id => $layout) {
    $new[$page_id] = $page_props[$page_id] ?? ['#type' => 'webform_wizard_page'];
    foreach ($layout as $layout_key) {
      if (array_key_exists($layout_key, $children)) {
        $new[$page_id][$layout_key] = $children[$layout_key];
      }
    }
  }
  foreach ($root_extras as $extra_key => $extra) {
    $new[$extra_key] = $extra;
  }

  $webform->setElements($new);
  $webform->save();

  $messages = [];
  $messages[] = (string) t('Simplified the hg Express Courier journey: Step 1 now holds the service, the mode, pickup beside dropoff, and the Courier package block with one weight field beside the contents attestation and the one-person handling question; Step 2 keeps the pickup arrival and the estimate; Step 3 opens with name, phone, and email in one row.');
  $messages[] = (string) t('Added @count element(s), all new keys: @keys.', [
    '@count' => 9,
    '@keys' => 'address_row, courier_package_row, courier_handling, courier_prohibited_ack, pickup_same_as_sender, contact_row, pickup_contact_row, delivery_contact_row, quote_information',
  ]);
  $messages[] = (string) t('The weight field is now labelled Weight (lb) and total_weight_unit is a hidden pounds-only input, so the pickup-arrival endpoint always reads a unit it understands.');

  if ($retired_keys !== []) {
    $messages[] = (string) t('@count Courier question(s) stopped being asked on the create form and are now settled server-side, without losing their key, their options, or their submission-view access: @keys.', [
      '@count' => count($retired_keys),
      '@keys' => implode(', ', $retired_keys),
    ]);
  }

  if ($hidden_for_courier !== []) {
    $messages[] = (string) t('@count move-only block(s) no longer render for Courier and are unchanged for every other service: @keys.', [
      '@count' => count($hidden_for_courier),
      '@keys' => implode(', ', $hidden_for_courier),
    ]);
  }

  $messages[] = (string) t('The quote notice is now a collapsed "Important information regarding your quote" details element. No element was deleted, so historical submissions read exactly as before.');

  return implode(' ', $messages);
}

/**
 * Screens the prohibited-contents affirmation on the Dispatch offer path.
 *
 * Update 10027 replaced the Courier contents radio with a compact checkbox, which
 * closed a gap it also widened. The offer path reads its facts from
 * request_fields, and the only contents key mapped there was the radio - which the
 * simplified journey no longer renders, and which in this site's active
 * configuration was not mapped at all. So an unaffirmed package could be quoted as
 * Manual Review and still be shown pickup arrivals, which is the quote-versus-Slot
 * contradiction the planner is built to avoid.
 *
 * The affirmation is now a required answer rather than a handling marker, because
 * the case to catch is silence: a marker rule refuses a stated bad answer, and an
 * unchecked box states nothing. Both controls are mapped, so a historic submission
 * that affirmed through the old radio still confirms, and the empty handling-marker
 * mapping is repaired at the same time so a stated 'restricted' or 'unsure' is
 * refused again on the paths that still render the radio.
 *
 * Reuses 10013's seed-then-enforce pass rather than restating it, so there is one
 * definition of these invariants. It seeds only where the active object holds no
 * value, never touches resource.working_hours or resource.breaks, and so cannot
 * overwrite an operator's approved schedule. Running it twice changes nothing.
 */
function custom_webform_handlers_update_10028(): string {
  $name = 'custom_webform_handlers.dispatch';
  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($directory);

  $shipped = $source->read($name);
  if (!is_array($shipped)) {
    throw new \Drupal\Core\Utility\UpdateException(sprintf('The default configuration %s.yml could not be read from %s.', $name, $directory));
  }

  $config = \Drupal::configFactory()->getEditable($name);
  if ($config->isNew()) {
    $config->setData($shipped)->save();

    return (string) t('@name was absent and was installed from the shipped defaults, including the prohibited-contents affirmation.', ['@name' => $name]);
  }

  // The same two paths 10013 refuses to seed: a default written into either one
  // would invent business hours for a real Resource.
  $never_seed = [
    'resource.working_hours',
    'resource.breaks',
  ];

  $original = $config->getRawData();
  $seeded = [];
  $repaired = [];
  $data = _custom_webform_handlers_seed_absent($original, $shipped, '', $never_seed, $seeded);
  $data = _custom_webform_handlers_enforce_dispatch_invariants($data, $shipped, $repaired);

  if ($data === $original) {
    return (string) t('@name already required the prohibited-contents affirmation and named the elements it is read from. No changes were made.', ['@name' => $name]);
  }

  $config->setData($data)->save();

  return (string) t('@name updated. Defaults seeded: @seeded. Values corrected: @repaired. An unaffirmed Courier package is now Manual Review with zero Slots on the offer path as well as in the quote.', [
    '@name' => $name,
    '@seeded' => $seeded === [] ? (string) t('none') : implode(', ', $seeded),
    '@repaired' => $repaired === [] ? (string) t('none') : implode(', ', $repaired),
  ]);
}

/**
 * Stops the dimension questions from rendering in the Express Courier journey.
 *
 * Update 10027 added the Courier exclusion to shipment_measurements by appending
 * it to the condition already there, producing the list form
 * [{service_type: filled}, 'and', {service_type: '!value' courier}]. Webform
 * honours that operator when it validates conditions on the server, but the
 * browser does not: core's states.js treats an array of conditions as OR unless
 * the array contains 'xor', and 'and' is not a client-side operator at all. So
 * "filled AND not Courier" was evaluated in the browser as "filled OR not
 * Courier", which is true for Courier the moment a service is chosen, and the
 * fieldset kept rendering on step 2 of the Courier journey.
 *
 * The single-condition map that the other move-only questions beside it already
 * use - preferred_service_date, preferred_service_time, date_flexibility - is
 * read the same way on both sides, so it replaces the list here. The filled test
 * is dropped rather than preserved: service_type is answered on step 1 before
 * step 2 can be reached, so it excluded nothing, and a second test on the same
 * trigger is what created the ambiguity in the first place.
 *
 * Each of the five questions inside the fieldset gets the same condition,
 * because an element's own visible state is evaluated independently of its
 * parent's - four of them asked only for a filled service_type, and
 * dimension_unit asked for nothing. No element is renamed or removed, and no
 * other service is affected: everything except Courier still sees the fieldset
 * exactly as before.
 */
function custom_webform_handlers_update_10029(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the dimension questions were left unchanged.');
  }

  $elements = $webform->getElementsDecoded();
  if (!isset($elements['page_2']['shipment_measurements']) || !is_array($elements['page_2']['shipment_measurements'])) {
    return (string) t('The hg webform does not carry page_2 shipment_measurements where this update expects it, so its elements were left unchanged for manual review.');
  }

  // The one condition every other move-only question on this page already uses.
  $non_courier = [':input[name="service_type"]' => ['!value' => 'courier']];

  // Only the visible rule is rewritten. A required rule, an access rule, or any
  // other property on these elements is left exactly as the operator has it.
  $apply = static function (array $element, array $condition, string $key, array &$changed): array {
    $states = (isset($element['#states']) && is_array($element['#states'])) ? $element['#states'] : [];
    if (array_key_exists('visible', $states) && $states['visible'] === $condition) {
      return $element;
    }
    $states['visible'] = $condition;
    $element['#states'] = $states;
    $changed[] = $key;

    return $element;
  };

  $changed = [];
  $fieldset = &$elements['page_2']['shipment_measurements'];
  $fieldset = $apply($fieldset, $non_courier, 'shipment_measurements', $changed);
  foreach (['item_quantity', 'item_length', 'item_width', 'item_height', 'dimension_unit'] as $dimension) {
    if (!isset($fieldset[$dimension]) || !is_array($fieldset[$dimension])) {
      continue;
    }
    $fieldset[$dimension] = $apply($fieldset[$dimension], $non_courier, $dimension, $changed);
  }
  unset($fieldset);

  if ($changed === []) {
    return (string) t('The hg dimension questions already carried the non-Courier visibility condition on their own, so nothing was changed.');
  }

  $webform->setElements($elements);
  $webform->save();

  return (string) t('@count hg element(s) now hide for Express Courier and are unchanged for every other service: @keys. The browser and the server read the same condition, so the Courier step 2 no longer asks for item counts or dimensions it does not price.', [
    '@count' => count($changed),
    '@keys' => implode(', ', $changed),
  ]);
}

/**
 * Escapes the hyphen in the phone patterns so browsers can compile them again.
 *
 * The three phone fields carry an HTML pattern written as [ .-], with the hyphen
 * unescaped. Browsers now compile a pattern attribute as a unicodeSets ('v')
 * regular expression, and there a bare hyphen inside a character class is a
 * syntax error rather than a literal. Chrome therefore throws
 * "Invalid character in character class" the moment anything evaluates the
 * field - which means the console carries an uncaught SyntaxError on the contact
 * step and, worse, the browser silently stops enforcing the pattern at all,
 * because a pattern that does not compile is treated as no constraint.
 *
 * Escaping the hyphen to [ .\-] compiles under both the older 'u' semantics and
 * the current 'v' semantics and matches exactly the same phone numbers, in the
 * browser and in PCRE, so nothing about which numbers are accepted changes -
 * server-side validation was never affected and stays as it is.
 *
 * Only the one known-bad literal is rewritten, wherever it appears in the tree,
 * so an operator who has since written their own pattern keeps it, and running
 * this twice changes nothing.
 */
function custom_webform_handlers_update_10030(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the phone patterns were left unchanged.');
  }

  $broken = '(?:\+?1[ .-]?)?(?:\([0-9]{3}\)|[0-9]{3})[ .-]?[0-9]{3}[ .-]?[0-9]{4}';
  $fixed = '(?:\+?1[ .\-]?)?(?:\([0-9]{3}\)|[0-9]{3})[ .\-]?[0-9]{3}[ .\-]?[0-9]{4}';

  $elements = $webform->getElementsDecoded();
  $repaired = [];
  $walk = static function (array &$tree, string $parent) use (&$walk, $broken, $fixed, &$repaired): void {
    foreach ($tree as $key => &$value) {
      if (!is_string($key)) {
        continue;
      }
      if ($key === '#pattern' && is_string($value) && $value === $broken) {
        $value = $fixed;
        $repaired[] = $parent;
        continue;
      }
      if (!str_starts_with($key, '#') && is_array($value)) {
        $walk($value, $key);
      }
    }
  };
  $walk($elements, 'hg');

  if ($repaired === []) {
    return (string) t('No hg element carried the unescaped phone pattern, so nothing was changed.');
  }

  $webform->setElements($elements);
  $webform->save();

  return (string) t('@count hg phone pattern(s) now compile in the browser and enforce the same 10-digit US format they always described: @keys.', [
    '@count' => count($repaired),
    '@keys' => implode(', ', $repaired),
  ]);
}

/**
 * Stops the package description from blocking the Express Courier journey.
 *
 * package_description sits at page_1 > courier_details > package_description,
 * and courier_details is visible only when service_type is courier. So the field
 * renders for exactly one service - Express Courier - and there its own
 * condition, required when service_type is courier, made it mandatory. The lean
 * Courier journey is not supposed to ask for it at all, so step 1 could not be
 * completed without typing text into a question that no longer belongs there.
 *
 * The field is kept. Two things change, both scoped to the create form:
 *
 * 1. '#access_create_roles' is emptied, which is the same retirement idiom
 *    update_10027 used for courier_urgency and prohibited_items_ack. On the
 *    create form '#access' is then FALSE, so the element is not rendered, its
 *    submitted input is ignored rather than validated, and it falls back to its
 *    own default. That is what makes a stale or crafted value harmless: there is
 *    no accessible element for Webform to require or validate against.
 * 2. The Courier-only required condition is removed, so nothing claims the field
 *    is mandatory even if an operator later restores create access.
 *
 * '#access_view_roles' and '#access_update_roles' are deliberately untouched, so
 * the 25 historic submissions that carry a description still render and can still
 * be edited with their stored value, title and description intact.
 *
 * Non-Courier services are unaffected by construction: courier_details already
 * hides this field for every one of them, and Webform already cleared its value
 * there, so it neither rendered nor was required nor stored a value for a
 * non-Courier submission before this update, and none of that changes.
 *
 * No canonical internal value is written. Every consumer of the key was audited
 * across the module: only the generator script that defines the element, the
 * update_10027 layout list and a README row mention it. No quote input list, no
 * Dispatch request factory, no eligibility policy, no checkout mapping and no
 * JavaScript reads package_description, so an empty value breaks nothing
 * downstream and inventing filler text would only put words in a customer's
 * mouth on a record staff read.
 */
function custom_webform_handlers_update_10031(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the package description was left unchanged.');
  }

  $elements = $webform->getElementsDecoded();
  if (!isset($elements['page_1']['courier_details']['package_description'])
    || !is_array($elements['page_1']['courier_details']['package_description'])) {
    return (string) t('The hg webform does not carry page_1 courier_details package_description where this update expects it, so its elements were left unchanged for manual review.');
  }

  $element = &$elements['page_1']['courier_details']['package_description'];
  $changed = [];

  if (!array_key_exists('#access_create_roles', $element) || $element['#access_create_roles'] !== []) {
    $element['#access_create_roles'] = [];
    $changed[] = (string) t('it is no longer rendered or validated on the create form');
  }

  if (isset($element['#states']) && is_array($element['#states']) && array_key_exists('required', $element['#states'])) {
    unset($element['#states']['required']);
    if ($element['#states'] === []) {
      unset($element['#states']);
    }
    $changed[] = (string) t('the Courier-only required condition is gone');
  }

  // A literal '#required' would outrank a condition, so it is cleared too if some
  // earlier edit set one. Nothing in this module writes it today.
  if (!empty($element['#required'])) {
    unset($element['#required']);
    $changed[] = (string) t('the unconditional required flag is gone');
  }
  unset($element);

  if ($changed === []) {
    return (string) t('The hg package description already carried this configuration, so nothing was changed.');
  }

  $webform->setElements($elements);
  $webform->save();

  return (string) t('The hg package description is preserved with its stored answers and: @changes. Express Courier step 1 can now be completed without it, and every non-Courier service keeps the behaviour it already had.', [
    '@changes' => implode('; ', $changed),
  ]);
}

/**
 * Ask the single-driver handling question so Courier Slots can appear.
 *
 * The defect this closes was invisible in the form and loud in the result: an
 * eligible Express Courier request produced a successful instant estimate and an
 * empty Slot list, next to copy telling the customer a person had to confirm the
 * schedule.
 *
 * The cause was an asymmetry between the eligibility policy and the form, not a
 * fault in the planner. 'self_bookable.require_single_driver_handling' is TRUE and
 * 'request_fields.single_driver_handling' is mapped, so ConfigDispatchEligibility
 * consults this answer on every Courier request. The element, however, carried
 * only a 'visible' state, so it was an unticked checkbox that nobody was ever
 * asked to touch. An unticked checkbox submits no value, the request factory reads
 * a missing value as FALSE — correctly, since a safety fact must never be assumed
 * — and every default journey therefore returned manualReview(MultiPersonHandling)
 * with zero Slots. Replaying the browser's own offer payload with this one bit
 * flipped returns 19 Slots on the same Monday, which is how the cause was fixed
 * rather than guessed at.
 *
 * A checkbox cannot express this fact. '#states required' on a checkbox means "you
 * must tick it", so it would have converted a two-person job from a staff-reviewed
 * booking into a form the customer cannot submit at all — contradicting both this
 * element's own description and the Slot widget's "Submit the form and we will
 * follow up with times". The policy models the negative answer as a review outcome,
 * not a rejection, so the form has to be able to carry it.
 *
 * Radios with a Courier-only required condition express exactly that: the customer
 * must answer, both answers submit, "Yes" is self-bookable and "No" routes to staff
 * review with the honest message it always had. The values stay '1' and '0', which
 * is what the 29 historic rows already store in a mediumtext column, so no stored
 * answer changes meaning and none becomes unreadable. Both JavaScript collectors
 * already skip unchecked radios and keep a radio group scalar, so the offer payload
 * shape is unchanged, and an unanswered group simply omits the key — the same
 * fail-safe FALSE as before, now with a visible prompt instead of silence.
 *
 * The sibling contents attestation keeps its checkbox: it is a hard limit rather
 * than a routing question, and the module already treats those differently.
 *
 * SUPERSEDED by custom_webform_handlers_update_10035(). Asking the question fixed
 * the empty Slot list only for a customer who answered "Yes", which made the answer
 * the hidden difference between a passing browser fixture and a real visitor. The
 * right fix was one level up: Express Courier *is* a one-driver service, so the fact
 * is derived from 'self_bookable.single_driver_service_types' and
 * 'request_fields.single_driver_handling' is now empty. Read the paragraphs above as
 * the history of the diagnosis, not as a description of the current profile.
 */
function custom_webform_handlers_update_10032(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the single-driver question was left unchanged.');
  }

  $elements = $webform->getElementsDecoded();
  if (!isset($elements['page_1']['courier_details']['courier_package_row']['courier_handling']['single_driver_handling'])
    || !is_array($elements['page_1']['courier_details']['courier_package_row']['courier_handling']['single_driver_handling'])) {
    return (string) t('The hg webform does not carry the Courier handling attestations where this update expects them, so its elements were left unchanged for manual review.');
  }

  $element = &$elements['page_1']['courier_details']['courier_package_row']['courier_handling']['single_driver_handling'];
  $changed = [];

  $is_courier = [':input[name="service_type"]' => ['value' => 'courier']];
  $options = [
    '1' => 'Yes, one person can carry it',
    '0' => 'No, it needs two people',
  ];

  if (($element['#type'] ?? '') !== 'radios') {
    $element['#type'] = 'radios';
    $changed[] = (string) t('it is a two-option question instead of a silently unticked box');
  }

  if (($element['#options'] ?? NULL) !== $options) {
    $element['#options'] = $options;
    $changed[] = (string) t('its answers are stored as the same 1 and 0 the historic submissions carry');
  }

  if (($element['#title'] ?? '') !== 'Can one person carry this without help?') {
    $element['#title'] = 'Can one person carry this without help?';
    $changed[] = (string) t('its title asks a question rather than asserting the answer');
  }

  if (!isset($element['#states']) || !is_array($element['#states'])) {
    $element['#states'] = [];
  }
  if (($element['#states']['visible'] ?? NULL) !== $is_courier) {
    $element['#states']['visible'] = $is_courier;
    $changed[] = (string) t('it stays visible for Express Courier only');
  }
  if (($element['#states']['required'] ?? NULL) !== $is_courier) {
    $element['#states']['required'] = $is_courier;
    $changed[] = (string) t('Express Courier now requires an answer, so the eligibility policy is never told FALSE by default');
  }

  // A literal '#required' would outrank the condition and reach non-Courier
  // services, which never see this element. Nothing in this module writes one.
  if (!empty($element['#required'])) {
    unset($element['#required']);
    $changed[] = (string) t('the unconditional required flag is gone');
  }

  // Webform keeps each option on one line inside a flex column; the relaxation in
  // courier_layout.css covers radios as well as checkboxes, so no per-element
  // attribute is needed here.
  unset($element);

  if ($changed === []) {
    return (string) t('The hg single-driver question already carried this configuration, so nothing was changed.');
  }

  $webform->setElements($elements);
  $webform->save();

  return (string) t('The hg single-driver handling attestation now asks for an answer and: @changes. An eligible Express Courier request reaches its Slot list, a two-person job still submits for staff review, and every non-Courier service keeps the behaviour it already had.', [
    '@changes' => implode('; ', $changed),
  ]);
}

/**
 * Makes Preferred Service Date the one public date the Dispatch Planner plans.
 *
 * Express Courier arrived here with two date controls and no authoritative one.
 * The Webform's own `preferred_service_date` was masked for Courier by a
 * `!value courier` state, and the Slot widget built a second, nameless `Pickup
 * date` input in the DOM to stand in for it. Because that second control had no
 * name it was never submitted, so the day the planner planned existed only in the
 * browser: the offer request named a date, the submission proved a different one,
 * and nothing on the server compared the two.
 *
 * This closes it from both ends.
 *
 * The state mask comes off `preferred_service_date` and one unconditional
 * '#required' replaces the conditional one, so exactly one date input renders for
 * every service including Courier. The six non-Courier services already saw this
 * element as visible and required — their condition was "not courier", which is
 * always true for them — so their form is unchanged; only Courier gains the field
 * it should have had all along.
 *
 * `request_fields.requested_date` then names that element to the planner, which is
 * what makes it authoritative rather than merely visible: DispatchBooking re-reads
 * the date from the submitted values and refuses a request whose body disagrees,
 * and AddressDistanceHandler refuses a chosen arrival that does not fall on it. The
 * widget stops carrying a date control of its own in the same change.
 *
 * Nothing is deleted. `preferred_service_time` and `date_flexibility` keep the
 * Courier masks they already carry, every historic answer stays readable, and no
 * schedule, capacity, buffer, horizon, Hold, or Reservation behaviour is touched.
 * The element's own '#date_date_min' and '#date_date_max' are left as they are
 * because they are shared with six services the 30-day dispatch horizon does not
 * govern; a Courier date outside the planner's window is answered by the planner.
 *
 * Idempotent: each part is compared before it is written, and a re-run that finds
 * both already in place saves nothing.
 */
function custom_webform_handlers_update_10033(): string {
  $changed = [];

  $config = \Drupal::configFactory()->getEditable('custom_webform_handlers.dispatch');
  if (trim((string) $config->get('request_fields.requested_date')) !== 'preferred_service_date') {
    $config->set('request_fields.requested_date', 'preferred_service_date')->save();
    $changed[] = (string) t('the planner reads the requested date from the preferred_service_date element instead of from whatever day the browser posted');
  }

  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return $changed === []
      ? (string) t('The hg webform was not found and the dispatch mapping already named preferred_service_date, so nothing was changed.')
      : (string) t('The dispatch mapping now reads the requested date from preferred_service_date. The hg webform was not found, so its date element was left for manual review.');
  }

  $elements = $webform->getElementsDecoded();
  if (!isset($elements['page_2']['preferred_service_date'])
    || !is_array($elements['page_2']['preferred_service_date'])) {
    return (string) t('The hg webform does not carry preferred_service_date on page 2 where this update expects it, so its elements were left unchanged for manual review. Dispatch mapping changes, if any: @changes.', [
      '@changes' => $changed === [] ? (string) t('none') : implode('; ', $changed),
    ]);
  }

  $element = &$elements['page_2']['preferred_service_date'];
  $elements_changed = FALSE;

  // The mask is the defect: it is what hid the one legitimate date field from the
  // service that most needs it. Both arms go, not just 'visible' — a required
  // condition of "not courier" would keep Courier's own date optional.
  if (isset($element['#states'])) {
    unset($element['#states']);
    $elements_changed = TRUE;
    $changed[] = (string) t('the Courier mask is off the date field, so Express Courier customers see it');
  }

  if (($element['#required'] ?? NULL) !== TRUE) {
    $element['#required'] = TRUE;
    $elements_changed = TRUE;
    $changed[] = (string) t('a date is required once, unconditionally, for every service');
  }

  unset($element);

  if ($elements_changed) {
    $webform->setElements($elements);
    $webform->save();
  }

  if ($changed === []) {
    return (string) t('Preferred Service Date is already the one required public date field and the dispatch mapping already names it, so nothing was changed.');
  }

  return (string) t('Preferred Service Date is now the one public date field the Dispatch Planner plans, and: @changes. Express Courier shows a single date input above its pickup times, the six other services keep the date field they already had, and no element or stored answer was removed.', [
    '@changes' => implode('; ', $changed),
  ]);
}

/**
 * Retires the "confirmed after staff review" promise on the public date field.
 */
function custom_webform_handlers_update_10034(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the date field help text was left unchanged.');
  }

  $elements = $webform->getElementsDecoded();
  if (!isset($elements['page_2']['preferred_service_date'])
    || !is_array($elements['page_2']['preferred_service_date'])) {
    return (string) t('The hg webform does not carry preferred_service_date on page 2 where this update expects it, so its help text was left unchanged for manual review.');
  }

  // The old sentence was written when every request was scheduled by hand, and it
  // outlived that: a self-bookable Express Courier request is confirmed by picking
  // one of the arrival times below the field, not by staff afterwards. Leaving it
  // there told a customer who had just been offered nineteen bookable times that
  // none of them counted — the same contradiction the review wording caused, in
  // static copy that no verdict could clear.
  $wanted = (string) t('Select a date to see available pickup times.');
  $element = &$elements['page_2']['preferred_service_date'];
  $current = trim((string) ($element['#description'] ?? ''));
  if ($current === $wanted) {
    unset($element);

    return (string) t('The Preferred Service Date help text already reads "@wanted", so nothing was changed.', [
      '@wanted' => $wanted,
    ]);
  }

  $element['#description'] = $wanted;
  unset($element);
  $webform->setElements($elements);
  $webform->save();

  return (string) t('The Preferred Service Date help text now reads "@wanted" instead of "@old". No element, condition, or stored answer was changed.', [
    '@wanted' => $wanted,
    '@old' => $current === '' ? (string) t('(empty)') : $current,
  ]);
}

/**
 * Derives Courier one-driver handling from the service instead of asking for it.
 *
 * The defect this closes is a hidden fixture dependency. A browser fixture that
 * pre-answered 'single_driver_handling' = 1 got an instant estimate and nineteen
 * bookable Slots; a real customer who left the question alone, or whose wizard
 * carried a stale 0, got 'Manual review required' for an entirely valid 10 lb
 * Tuesday request. The difference between the two was one answer that the customer
 * should never have been asked for in the first place.
 *
 * Express Courier is *defined* as a one-driver, self-service courier: the Resource
 * is 'driver-01-vehicle-01' at capacity one, and 'self_bookable.max_package_lbs'
 * is a ceiling chosen so one person can carry the package unaided. So one-driver
 * handling is a property of the service, not a question, and this update moves it
 * to where the service is described. Three coordinated parts:
 *
 * 1. 'self_bookable.single_driver_service_types' gains 'courier'.
 *    DispatchRequestFactory reads it and resolves the fact TRUE before any element
 *    is consulted, on both its entry points — so the quote, the Dispatch offer, the
 *    checkout requote, and the confirmation re-check all agree, and a missing,
 *    stale, or crafted client value cannot change the verdict.
 * 2. 'request_fields.single_driver_handling' is emptied. That is also what stops the
 *    browser being asked: request_fields is the source of the widget's
 *    'value_fields' allowlist, so an empty key removes the element from the payload
 *    JavaScript collects and sends.
 * 3. The element is retired on the create form with the same '#access_create_roles'
 *    idiom update_10031 used for package_description, and its Courier-only visible
 *    and required conditions are removed.
 *
 * What is deliberately NOT changed. 'require_single_driver_handling' stays TRUE and
 * ConfigDispatchEligibility still enforces it, so a service the policy does not name
 * still has to prove the fact and unknown still means Manual Review. The weight
 * ceiling, the contents affirmation, the Store Pickup confirmation, the Delivery
 * Mode allowlist, both manual_review lists, operating hours, capacity, buffers,
 * Holds, Reservations, and checkout are all untouched: an overweight package, an
 * unattested one, an incomplete Store Pickup, a declared helper need, and a
 * multi_person handling flag are all still refused, and the last two are refused
 * before the courier branch is reached at all.
 *
 * Historic answers survive. '#access_view_roles' and '#access_update_roles' are not
 * touched, so every submission that carries a stored 1 or 0 still renders it with
 * these option labels. Non-Courier services never rendered, required, or stored
 * this element — 'courier_details' hides it for all of them — so nothing changes
 * for them either.
 *
 * Idempotent: every part is compared before it is written, and a re-run that finds
 * all of them in place saves nothing.
 */
function custom_webform_handlers_update_10035(): string {
  $changed = [];

  $config = \Drupal::configFactory()->getEditable('custom_webform_handlers.dispatch');

  $types = $config->get('self_bookable.single_driver_service_types');
  if (!is_array($types) || !in_array('courier', $types, TRUE)) {
    $types = is_array($types) ? array_values($types) : [];
    $types[] = 'courier';
    $config->set('self_bookable.single_driver_service_types', $types)->save();
    $changed[] = (string) t('Express Courier is declared a one-driver service, so the planner derives that fact from the service instead of from the browser');
  }

  if (trim((string) $config->get('request_fields.single_driver_handling')) !== '') {
    $config->set('request_fields.single_driver_handling', '')->save();
    $changed[] = (string) t('the one-driver fact is no longer read from a form element, so it is not collected or sent by JavaScript and a stale or crafted value cannot refuse a valid request');
  }

  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return $changed === []
      ? (string) t('The hg webform was not found and the dispatch profile already derived one-driver handling from the service, so nothing was changed.')
      : (string) t('The dispatch profile now derives one-driver handling from the service: @changes. The hg webform was not found, so its question was left for manual review.', [
        '@changes' => implode('; ', $changed),
      ]);
  }

  $path = ['page_1', 'courier_details', 'courier_package_row', 'courier_handling', 'single_driver_handling'];
  $elements = $webform->getElementsDecoded();
  if (!isset($elements['page_1']['courier_details']['courier_package_row']['courier_handling']['single_driver_handling'])
    || !is_array($elements['page_1']['courier_details']['courier_package_row']['courier_handling']['single_driver_handling'])) {
    return (string) t('The hg webform does not carry the single-driver question at @path where this update expects it, so its elements were left unchanged for manual review. Dispatch profile changes, if any: @changes.', [
      '@path' => implode(' > ', $path),
      '@changes' => $changed === [] ? (string) t('none') : implode('; ', $changed),
    ]);
  }

  $element = &$elements['page_1']['courier_details']['courier_package_row']['courier_handling']['single_driver_handling'];
  $elements_changed = FALSE;

  // On the create form '#access' is then FALSE: the element is not rendered, its
  // submitted input is ignored rather than validated, and there is nothing for a
  // crafted value to bind to. This is the retirement idiom, not CSS — the question
  // stops existing on the form rather than being painted over.
  if (!array_key_exists('#access_create_roles', $element) || $element['#access_create_roles'] !== []) {
    $element['#access_create_roles'] = [];
    $elements_changed = TRUE;
    $changed[] = (string) t('the single-driver question is no longer rendered, required, or validated on the public Courier form');
  }

  // Both arms go. 'visible' is what made it render for Courier and 'required' is
  // what made Courier customers answer it; leaving either would keep a question the
  // service has already answered, and a required condition on an inaccessible
  // element is a form nobody can submit if create access is ever restored.
  if (isset($element['#states'])) {
    unset($element['#states']);
    $elements_changed = TRUE;
    $changed[] = (string) t('its Courier-only visible and required conditions are gone');
  }

  // A literal '#required' would outrank a condition and reach every service.
  if (!empty($element['#required'])) {
    unset($element['#required']);
    $elements_changed = TRUE;
    $changed[] = (string) t('the unconditional required flag is gone');
  }
  unset($element);

  if ($elements_changed) {
    $webform->setElements($elements);
    $webform->save();
  }

  if ($changed === []) {
    return (string) t('Express Courier already derived one-driver handling from the service and already retired the question, so nothing was changed.');
  }

  return (string) t('Express Courier no longer asks whether one person can carry the package, and: @changes. A valid in-limit Courier request now reaches its bookable pickup times without a driver checkbox, historic answers still render with their own labels, and an overweight, unattested, restricted, or genuinely two-person job still goes to staff.', [
    '@changes' => implode('; ', $changed),
  ]);
}

/**
 * Records per-service booking profiles so no caller knows a service by name.
 *
 * The defect this closes is five copies of one decision. "Is this service
 * bookable, and by what rules?" was answered in five places from three different
 * configuration keys: ConfigDispatchEligibility read both service-type lists and
 * then guessed the Courier parent from 'count($services) === 1';
 * DispatchRequestFactory read 'self_bookable.single_driver_service_types';
 * AddressDistanceHandler compared 'service_type' to the literal 'courier';
 * QuoteCalculator switched on the raw service string; and the browser received a
 * flattened copy of one of those lists. Five copies is five chances to disagree,
 * and a disagreement here publishes a Slot for a job nobody can time.
 *
 * This update writes the data behind BookingProfileResolverInterface, which is
 * now the only seam those callers use. Two services are stated explicitly:
 *
 * 1. 'courier' declares 'duration_resolver: courier'. That inference was correct
 *    only while exactly one service was open, and it would have silently reduced
 *    Express Courier to a move the moment a second one was. The heuristic remains
 *    as a fallback for a service with no entry, so a configuration this task did
 *    not touch behaves identically, but it no longer decides the shipped case.
 * 2. 'on_demand_delivery' declares 'review_policy: always_review' with the one
 *    sentence a visitor is owed. Without it the pilot inherits Courier's
 *    assessed refusal code, 'contents_or_add_ons', whose sentence is about
 *    package contents and add-ons — wrong for a service that is Manual Review
 *    because its duration cannot be computed at all.
 *
 * What is deliberately NOT written. No entry for the other five Manual Review
 * services: each is already in 'manual_review.service_types', so the resolver's
 * fallback keeps their refusal reason, their assessed public copy and their price
 * book exactly as they are, and an absent entry is the honest way to say "nothing
 * about this service changed". No schedule, capacity, buffer, horizon, allowlist,
 * price, Hold, Reservation or Webform change of any kind: this update adds one
 * configuration key and nothing else.
 *
 * 'selected_slot_field' is shell-level rather than per service because the pilot
 * renders the same widget as Courier, and two services writing different Slot
 * elements is how a stale selection survives a service change.
 *
 * Idempotent: every leaf is compared before it is written, and a re-run that
 * finds all of them in place saves nothing.
 */
function custom_webform_handlers_update_10036(): string {
  $config = \Drupal::configFactory()->getEditable('custom_webform_handlers.dispatch');
  $changed = [];

  if (trim((string) $config->get('booking_profiles.selected_slot_field')) === '') {
    $config->set('booking_profiles.selected_slot_field', 'dispatch_slot')->save();
    $changed[] = (string) t('the canonical selected-Slot element is named once for the shared shell');
  }

  if (trim((string) $config->get('booking_profiles.eligibility_policy')) === '') {
    $config->set('booking_profiles.eligibility_policy', 'custom_webform_handlers.dispatch_eligibility')->save();
    $changed[] = (string) t('the policy that assesses a self-bookable service is named in configuration instead of assumed in code');
  }

  $wanted = [
    'courier' => [
      'mode' => 'self_bookable',
      'duration_resolver' => 'courier',
      'quote_strategy' => 'courier',
      'claims_capacity' => TRUE,
      'single_driver_service' => TRUE,
      'review_policy' => 'offer_assessed',
      'review_message' => '',
    ],
    'on_demand_delivery' => [
      'mode' => 'manual_review',
      'duration_resolver' => '',
      'quote_strategy' => 'on_demand_delivery',
      'claims_capacity' => FALSE,
      'single_driver_service' => FALSE,
      'review_policy' => 'always_review',
      'review_message' => 'This delivery needs a quick review before pickup times can be confirmed.',
    ],
  ];

  $services = $config->get('booking_profiles.services');
  $services = is_array($services) ? $services : [];

  foreach ($wanted as $service => $profile) {
    $current = (isset($services[$service]) && is_array($services[$service])) ? $services[$service] : [];
    $missing = [];
    foreach ($profile as $fact => $value) {
      if (!array_key_exists($fact, $current)) {
        $current[$fact] = $value;
        $missing[] = $fact;
      }
    }
    if ($missing === []) {
      continue;
    }
    $services[$service] = $current;
    $config->set('booking_profiles.services', $services)->save();
    $changed[] = (string) t('@service now states @facts for itself', [
      '@service' => $service,
      '@facts' => implode(', ', $missing),
    ]);
  }

  if ($changed === []) {
    return (string) t('Every booking profile was already recorded, so nothing was changed.');
  }

  return (string) t('Booking profiles are now resolved from configuration rather than inferred by each caller: @changes. Express Courier keeps its own duration resolver whatever else is opened, On-Demand Delivery states one truthful review sentence instead of inheriting Courier\'s contents-and-add-ons wording, and the five other Manual Review services are unchanged because the resolver still derives their rules from the lists they are already in.', [
    '@changes' => implode('; ', $changed),
  ]);
}

/**
 * Stop asking On-Demand Delivery the two legacy fixed date/time questions.
 *
 * The pilot renders the same public scheduling shell as Express Courier: one
 * Preferred Service Date, one 'Choose your pickup time' widget, one 'Times
 * shown in New York local time' label. Two older elements contradict that
 * shell. 'preferred_service_time' is a fixed morning/afternoon select and
 * 'date_flexibility' is a radios question about moving the date, and both are
 * currently marked visible and required for every service that is not Courier
 * — so both render for On-Demand, which is a second time control and a second
 * date control beside the widget.
 *
 * Why a negated pattern rather than a second condition. A #states arm holding a
 * list of conditions is evaluated as OR by Drupal.states in the browser, so
 * 'not courier' plus 'not on_demand_delivery' written as two rules would still
 * resolve true for the pilot and the element would stay on screen while the
 * server hid it. One selector carrying a single negated pattern has no such
 * split: Drupal.states.Dependent.comparisons.Object reads '!pattern' directly,
 * and WebformSubmissionConditionsValidator promotes the same substate before
 * evaluating it with preg_match, so client and server reach one answer.
 *
 * Nothing reads these two elements at runtime. No handler, quote strategy,
 * eligibility policy, booking profile or notification consults either key, so
 * un-asking them for one service changes no price, no review outcome and no
 * message. Historic answers stay in their submissions and stay readable.
 *
 * What is deliberately NOT changed. The other five Manual Review services keep
 * asking both questions exactly as before, because only the pilot was given the
 * Courier shell. Express Courier's own exclusion is unchanged — it is simply now
 * expressed as one alternative in the pattern instead of a bare '!value'.
 *
 * Idempotent: each arm is compared with the wanted condition before it is
 * written, and a re-run that finds both elements already limited saves nothing.
 */
function custom_webform_handlers_update_10037(): string {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return (string) t('The hg webform was not found, so the legacy scheduling questions were left for manual review.');
  }

  // The services that still ask a fixed service time and a date-flexibility
  // question: everything except the two that render the Slot widget instead.
  $asked_by_neither_shell_service = [
    ':input[name="service_type"]' => [
      'value' => ['!pattern' => '^(courier|on_demand_delivery)$'],
    ],
  ];

  $elements = $webform->getElementsDecoded();
  $changed = [];
  $missing = [];

  foreach (['preferred_service_time', 'date_flexibility'] as $key) {
    if (!isset($elements['page_2'][$key]) || !is_array($elements['page_2'][$key])) {
      $missing[] = $key;
      continue;
    }

    $element = &$elements['page_2'][$key];
    foreach (['visible', 'required'] as $arm) {
      if (($element['#states'][$arm] ?? NULL) === $asked_by_neither_shell_service) {
        continue;
      }
      $element['#states'][$arm] = $asked_by_neither_shell_service;
      $changed[] = $key . ' (' . $arm . ')';
    }
    unset($element);
  }

  if ($changed !== []) {
    $webform->setElements($elements)->save();
  }

  if ($changed === [] && $missing === []) {
    return (string) t('Both legacy scheduling questions were already limited to the services that still ask them, so nothing was changed.');
  }

  if ($changed === []) {
    return (string) t('No legacy scheduling question needed limiting. These keys were not found on page 2 and were left alone: @missing.', [
      '@missing' => implode(', ', $missing),
    ]);
  }

  $sentence = (string) t('On-Demand Delivery no longer renders a second time control or a second date question beside its pickup-time widget: @changed now apply only to the services that still ask them. The five other Manual Review services keep both questions unchanged, and answers already stored against either element are untouched.', [
    '@changed' => implode(', ', $changed),
  ]);

  if ($missing !== []) {
    $sentence .= ' ' . (string) t('These keys were not found on page 2 and were left alone: @missing.', [
      '@missing' => implode(', ', $missing),
    ]);
  }

  return $sentence;
}

/**
 * Installs the read-only Reservation Dashboard over the Dispatch ledger.
 *
 * The listing beside the board, and the reason it is a view rather than another
 * controller: the board answers "what does the day look like", which needs
 * arranging, while this answers "show me the rows, filtered, in an order I
 * chose", which needs no code at all once the ledger is declared to Views. So
 * the module stays one query deep — one base-table definition in
 * custom_webform_handlers.views.inc, one page on top of it, and no second
 * implementation of the board's question.
 *
 * Read from this module's own config/install rather than restated here, so a
 * freshly installed site and an already-installed one get the same page from
 * the same file.
 *
 * Idempotent, and deliberately not an overwrite. A view already carrying this
 * machine name is left exactly as it is, whichever of the two things it is:
 * this module's own dashboard from an earlier run or a fresh install, or
 * somebody else's page that got there first. The second case is reported as a
 * conflict rather than resolved, because a saved view is somebody's work and
 * replacing it silently is how an operator loses a page they built.
 */
function custom_webform_handlers_update_10038(): string {
  $id = 'dispatch_reservations';
  $storage = \Drupal::entityTypeManager()->getStorage('view');

  $directory = \Drupal::service('extension.list.module')->getPath('custom_webform_handlers') . '/config/install';
  $file = $directory . '/views.view.' . $id . '.yml';
  $source = new \Drupal\Core\Config\FileStorage($directory);

  $definition = $source->read('views.view.' . $id);
  if (!is_array($definition)) {
    return (string) t('The Reservation Dashboard view is missing from this module’s config/install, so nothing was installed and no existing page was touched. Expected it at @file.', [
      '@file' => $file,
    ]);
  }

  $existing = $storage->load($id);
  if ($existing instanceof \Drupal\views\ViewEntityInterface) {
    return custom_webform_handlers_reservation_view_report($existing, $definition, $file);
  }

  $storage->create($definition)->save();
  // The route the page display defines has to exist before the menu link that
  // names it can resolve to anything, so the router is rebuilt first and the
  // link tree second. Saving a view already flags both as stale; doing the work
  // here means the page and its link answer at the end of this update rather
  // than at whatever cache rebuild happens next.
  \Drupal::service('router.builder')->rebuild();
  \Drupal::service('plugin.manager.menu.link')->rebuild();

  return (string) t('Installed the Reservation Dashboard at /@path, beside the Dispatch Planner board and not instead of it. It reads the Dispatch reservation ledger and writes nothing back: there is no edit, delete, bulk or export operation on the page, and the columns carrying customer contact, exact addresses and price are built only for accounts holding those permissions — an account without one gets no column, not a blank one. Every instant is printed in @zone.', [
    '@path' => $definition['display']['page_1']['display_options']['path'] ?? '',
    '@zone' => 'America/New_York',
  ]);
}
/**
 * Says which of two things already owns the dispatch_reservations name.
 *
 * Separated because the two outcomes need different sentences and only one of
 * them is good news: an update that reported both with the same words would be
 * telling an operator their dashboard is installed when it is not.
 *
 * "Already there" means an earlier run of this update, or a fresh install, put
 * this module's own page on that name — nothing to do, and nothing to say about
 * the columns or filters somebody has tuned since. "Conflicting" means a page
 * built elsewhere answers on that name: it is left alone, the dashboard is not
 * installed, and the message names the shipped file, because this hook has now
 * run and will not try again on its own.
 *
 * The test is deliberately shallow — the table it reads and the path it answers
 * on — because those are the two things that make a view this one rather than a
 * namesake. A stricter comparison would call an operator's own edits a conflict.
 */
function custom_webform_handlers_reservation_view_report(\Drupal\views\ViewEntityInterface $existing, array $definition, string $file): string {
  $wanted_table = (string) ($definition['base_table'] ?? '');
  $wanted_path = (string) ($definition['display']['page_1']['display_options']['path'] ?? '');

  $found_table = (string) $existing->get('base_table');
  $found_paths = [];
  foreach ((array) $existing->get('display') as $display) {
    $path = is_array($display) ? ($display['display_options']['path'] ?? NULL) : NULL;
    if (is_string($path) && $path !== '') {
      $found_paths[] = $path;
    }
  }
  if ($found_table === $wanted_table && in_array($wanted_path, $found_paths, TRUE)) {
    return (string) t('The Reservation Dashboard was already installed at /@path and was left exactly as configured, including any column, filter, sort or pager setting changed since.', [
      '@path' => $wanted_path,
    ]);
  }

  return (string) t('A view called @label already uses the machine name @id, so the Reservation Dashboard was not installed and that view was not touched. It reads @found and answers on @where, where this module’s page reads @wanted at /@path. Import @file under a machine name of your choosing when you want the dashboard; this update has run and will not try again.', [
    '@label' => $existing->label(),
    '@id' => $existing->id(),
    '@found' => $found_table !== '' ? $found_table : t('no base table'),
    '@where' => $found_paths !== [] ? implode(', ', $found_paths) : t('no page path'),
    '@wanted' => $wanted_table,
    '@path' => $wanted_path,
    '@file' => $file,
  ]);
}

/**
 * Standardises every service on the one shared pickup-date shell.
 *
 * Two services already render it: Express Courier, which is bookable, and the
 * On-Demand Delivery pilot, which is not. The other five Manual Review services
 * still ask their own fixed `Preferred Service Time` and `Date flexibility`
 * questions beside the same widget, so a visitor scheduling a home move is asked
 * *when* three times on one page and answers two questions nothing reads. This
 * finishes the shell for all seven.
 *
 * Nothing here decides anything new about a service. The five profiles are
 * already Manual Review — they are in `manual_review.service_types`, and the
 * resolver derives the same mode, the same refusal reason and the same duration
 * resolver from that list whether or not an entry exists. What the entries add is
 * the *published* half: `review_policy: always_review` plus one truthful sentence
 * each, which is what lets the widget answer from the service alone instead of
 * posting an offer request whose only possible answer it already knows, and paint
 * a service-specific sentence rather than Courier's contents-and-add-ons wording.
 *
 * @see \Drupal\custom_webform_handlers\Dispatch\Profile\ConfigBookingProfileResolver::reviewResult()
 * @see \Drupal\custom_webform_handlers\Dispatch\Profile\BookingProfile::toPublishedArray()
 *
 * Deliberately absent: any duration, access, parking, add-on, driver, capacity or
 * price mapping. `durations.move.access_minutes`, `parking_minutes` and
 * `add_on_minutes` stay empty and `request_fields.specialty_item_count` stays
 * unmapped, and each of those independently makes the move duration resolver
 * return NULL. That is what keeps a Manual Review service from becoming
 * self-bookable here, so it is a property to preserve rather than a gap to fill.
 * `quote_strategy` names each service's existing price-book key — the same value
 * the resolver already derives from the service type — so no figure moves.
 *
 * Idempotent in both halves: every profile fact is compared before it is written,
 * the two retired questions are checked for the access they already carry, and a
 * re-run that finds the shell in place saves nothing. Missing element keys are
 * reported rather than created.
 */
function custom_webform_handlers_update_10039(): string {
  $changed = [];
  $changed = array_merge($changed, custom_webform_handlers_shell_profiles_10039());
  [$element_changes, $missing] = custom_webform_handlers_shell_elements_10039();
  $changed = array_merge($changed, $element_changes);

  if ($changed === [] && $missing === []) {
    return (string) t('All seven services already share one pickup-date shell: one Preferred Service Date, one pickup-time widget, and no legacy time or flexibility question. Nothing was changed.');
  }

  $sentence = $changed === []
    ? (string) t('The shared pickup-date shell needed no change.')
    : (string) t('Every service now shares one pickup-date shell: @changes. No schedule, resource, queue, reservation, price book, Commerce order or payment record was touched, and no Manual Review service became self-bookable — the five move profiles state a review sentence and nothing else about how a job would be timed.', [
      '@changes' => implode('; ', $changed),
    ]);

  if ($missing !== []) {
    $sentence .= ' ' . (string) t('These element keys were not found where the shell expects them and were left alone: @missing.', [
      '@missing' => implode(', ', $missing),
    ]);
  }

  return $sentence;
}

/**
 * Publishes the five remaining Manual Review profiles. Helper for 10039.
 *
 * Each entry restates what the resolver already derives — `mode: manual_review`
 * from `manual_review.service_types`, `duration_resolver: ''` from that mode,
 * `quote_strategy` equal to the service type because an absent key resolves to
 * exactly that, `claims_capacity: false` from the mode, `single_driver_service:
 * false` because none is in `single_driver_service_types` — and then adds the two
 * facts that are not derivable: `review_policy: always_review` and one sentence
 * of the service's own.
 *
 * That is the whole seam. `always_review` is what the widget reads to answer from
 * the service alone, and the sentence is what it paints instead of Courier's
 * contents-and-add-ons wording. Server-side the pair is inert: only
 * BookingProfile::alwaysUnderReview() and ::reviewMessage() read them, and the
 * refusal reason these five report is ManualReview either way because they are
 * already listed.
 *
 * The sentences promise a review, never a time, a price or a confirmation the
 * operator has not made.
 *
 * @return string[]
 *   One change sentence per service that gained facts; empty when all present.
 */
function custom_webform_handlers_shell_profiles_10039(): array {
  $wanted = [
    'local_residential_move' => 'A move coordinator reviews your home move and confirms the pickup window with you.',
    'local_commercial_move' => 'A move coordinator reviews your commercial move and confirms the pickup window with you.',
    'long_distance_move' => 'A move coordinator reviews your long-distance shipment and confirms the pickup window with you.',
    'specialty_item_move' => 'A specialty-item coordinator reviews the item and access details, then confirms the pickup window with you.',
    'diy_truck_rental' => 'A rental coordinator confirms truck availability and your pickup window before anything is scheduled.',
  ];

  $config = \Drupal::configFactory()->getEditable('custom_webform_handlers.dispatch');
  $services = $config->get('booking_profiles.services');
  $services = is_array($services) ? $services : [];
  $changed = [];

  foreach ($wanted as $service => $message) {
    $profile = [
      'mode' => 'manual_review',
      'duration_resolver' => '',
      'quote_strategy' => $service,
      'claims_capacity' => FALSE,
      'single_driver_service' => FALSE,
      'review_policy' => 'always_review',
      'review_message' => $message,
    ];

    $current = (isset($services[$service]) && is_array($services[$service])) ? $services[$service] : [];
    $added = [];
    foreach ($profile as $fact => $value) {
      if (!array_key_exists($fact, $current)) {
        $current[$fact] = $value;
        $added[] = $fact;
      }
    }
    if ($added === []) {
      continue;
    }

    $services[$service] = $current;
    $config->set('booking_profiles.services', $services)->save();
    $changed[] = (string) t('@service now states @facts for itself', [
      '@service' => $service,
      '@facts' => implode(', ', $added),
    ]);
  }

  return $changed;
}

/**
 * Retires the two legacy scheduling questions. Helper for 10039.
 *
 * `update_10037()` narrowed `preferred_service_time` and `date_flexibility` to
 * the services that had not yet been given the shared shell. All seven have it
 * now, so the honest end state is not a narrower condition but no question: both
 * are un-asked of everyone creating a booking request.
 *
 * `#access_create_roles: []` is the server-enforced mechanism, not CSS. Webform
 * resolves it to `#access: FALSE` while the form is built, which means no `name=`
 * attribute is rendered, the element cannot be required, and — the part that
 * matters for crafted input — WebformSubmissionForm ignores any submitted value
 * for it in favour of `#default_value`. So a hand-rolled POST carrying
 * `preferred_service_time=09:00` cannot restore the control, cannot reach a
 * handler and cannot compete with `dispatch_slot`.
 *
 * @see \Drupal\webform\Plugin\WebformElementBase::checkAccessRule()
 *
 * Both `#states` arms are deleted with it. An element nobody is asked must not
 * carry a conditional `required` rule: that pair is exactly how a form locks out
 * a visitor who can see no way to satisfy it, and 10037 left `required` live for
 * the five move services. Titles, options and `#default_value` stay, and neither
 * `#access_view_roles` nor `#access_update_roles` is touched, so every answer
 * already stored against either element stays readable in its submission.
 *
 * @return array
 *   [string[] change sentences, string[] element keys not found].
 */
function custom_webform_handlers_shell_elements_10039(): array {
  $webform = \Drupal\webform\Entity\Webform::load('hg');
  if ($webform === NULL) {
    return [[], ['hg (the webform itself was not found)']];
  }

  $elements = $webform->getElementsDecoded();
  $changed = [];
  $missing = [];

  foreach (['preferred_service_time', 'date_flexibility'] as $key) {
    if (!isset($elements['page_2'][$key]) || !is_array($elements['page_2'][$key])) {
      $missing[] = $key;
      continue;
    }

    $element = &$elements['page_2'][$key];
    $retired = array_key_exists('#access_create_roles', $element)
      && (array) $element['#access_create_roles'] === [];
    if (!$retired) {
      $element['#access_create_roles'] = [];
      $changed[] = (string) t('@key is no longer asked of anyone creating a booking request', ['@key' => $key]);
    }

    foreach (['visible', 'required'] as $arm) {
      if (!isset($element['#states'][$arm])) {
        continue;
      }
      unset($element['#states'][$arm]);
      $changed[] = (string) t('@key no longer carries a conditional @arm rule', [
        '@key' => $key,
        '@arm' => $arm,
      ]);
    }
    if (isset($element['#states']) && (array) $element['#states'] === []) {
      unset($element['#states']);
    }
    unset($element);
  }

  $changed = array_merge($changed, custom_webform_handlers_shell_date_10039($elements, $missing));

  if ($changed !== []) {
    $webform->setElements($elements)->save();
  }

  return [$changed, $missing];
}

/**
 * Guarantees the one authoritative date question. Helper for 10039.
 *
 * `preferred_service_date` already is what this asserts on both sites — required,
 * ungated, asked of everyone — so the expected result is no change at all. It is
 * written as an assertion rather than assumed because the shell's whole claim is
 * that seven services share one date input, and a `#states` arm or a retired
 * access rule on this one element would break that claim silently while every
 * other part of the update looked correct.
 *
 * An ungated date is the point. Gating it on `service_type` is how a second date
 * question appeared in the first place: two elements each visible for a different
 * set of services read as one question to whoever maintains the form and as two
 * to whoever fills it in.
 *
 * @param array $elements
 *   The decoded element tree, edited in place.
 * @param array $missing
 *   Collected keys that were not found, appended to in place.
 *
 * @return string[]
 *   Change sentences; empty when the date question already satisfies the shell.
 */
function custom_webform_handlers_shell_date_10039(array &$elements, array &$missing): array {
  $key = 'preferred_service_date';
  if (!isset($elements['page_2'][$key]) || !is_array($elements['page_2'][$key])) {
    $missing[] = $key . ' (the shared shell has no date question without it)';
    return [];
  }

  $element = &$elements['page_2'][$key];
  $changed = [];

  if (array_key_exists('#access_create_roles', $element)
    && (array) $element['#access_create_roles'] === []) {
    unset($element['#access_create_roles']);
    $changed[] = (string) t('@key is asked again of everyone creating a booking request', ['@key' => $key]);
  }
  if (array_key_exists('#access', $element) && $element['#access'] === FALSE) {
    unset($element['#access']);
    $changed[] = (string) t('@key is visible again', ['@key' => $key]);
  }

  foreach (['visible', 'required'] as $arm) {
    if (!isset($element['#states'][$arm])) {
      continue;
    }
    unset($element['#states'][$arm]);
    $changed[] = (string) t('@key is no longer conditional on another answer (@arm)', [
      '@key' => $key,
      '@arm' => $arm,
    ]);
  }
  if (isset($element['#states']) && (array) $element['#states'] === []) {
    unset($element['#states']);
  }

  if (empty($element['#required'])) {
    $element['#required'] = TRUE;
    $changed[] = (string) t('@key is required for every new booking request', ['@key' => $key]);
  }
  unset($element);

  return $changed;
}

/**
 * Implements hook_update_N().
 *
 * Reconciles an already-installed site with the handling flag the module's own
 * code produces.
 *
 * `AddressDistanceHandler::…()` maps an attestation that is absent, unchecked or
 * crafted to `unsure` before Dispatch ever sees the request, and
 * `DispatchRequestFactory` reads `unsure` as the customer telling us something.
 * If `unsure` is not in `manual_review.handling_flags`, that signal is dropped:
 * the request the customer did not vouch for is read as a clean answer instead
 * of being sent to Manual Review. The packaged baseline carries the flag; this
 * site's stored copy predates it.
 *
 * Narrow on purpose. The resource schedule, capacity, buffers and the Dispatch
 * allowlist are site-tuned values that a reconciliation hook must not overwrite,
 * so only this one list is touched, and only by addition.
 */
function custom_webform_handlers_update_10040(): string {
  $config = \Drupal::configFactory()->getEditable('custom_webform_handlers.dispatch');
  $flags = array_values(array_unique(array_filter(array_map(
    static fn ($flag): string => trim((string) $flag),
    (array) $config->get('manual_review.handling_flags'),
  ), static fn (string $flag): bool => $flag !== '')));

  if (in_array('unsure', $flags, TRUE)) {
    return (string) t('Manual Review already recognises the unsure handling flag over @count flags; nothing changed.', [
      '@count' => count($flags),
    ]);
  }

  $flags[] = 'unsure';
  $config->set('manual_review.handling_flags', $flags)->save();

  return (string) t('Manual Review now recognises @count handling flags including unsure, so an unattested or crafted acknowledgement is routed to review instead of being read as a clean answer.', [
    '@count' => count($flags),
  ]);
}
